nt="n30" connectable="0"><mxGeometry x="1.43" y="54.29" width="27.14" height="1.43" as="geometry"/></mxCell><mxCell id="n36" value="" style="vsdxID=104;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n30" connectable="0"><mxGeometry x="2.86" y="44.29" width="24.29" height="7.14" as="geometry"/></mxCell><mxCell id="n37" value="" style="vsdxID=105;fillColor=#2d5967;gradientColor=none;shape=stencil(lZFNDoMgEIVPw5bggIWurb2HiVhIKRikf7cvlDRVG23cvRm+eTPhIVoNquklAjIE787yrtugED0gAG2V9DpEhWiNaNU5L0/eXW2b675JZFIXd0sOjzxXEJJmgDw/NYZ345hpo+2IFntcwoQny/DUWHDMy2U47mVidsmKNysw32L/ezgDLHZr92z5l390FN8AOm1Mzm/8Pg8stnLYtH4B);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n30" connectable="0"><mxGeometry x="51.43" y="47.14" width="5.71" height="5.71" as="geometry"/></mxCell><mxCell id="n38" value="" style="vsdxID=106;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n30" connectable="0"><mxGeometry x="2.86" y="0.00" width="52.86" height="52.86" as="geometry"/></mxCell><mxCell id="n39" value="enable_default_policies=false&lt;br&gt;policies={}&lt;br&gt;Local CIS policy maps are gated by opt-in." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n29"><mxGeometry x="30.00" y="215.00" width="680.00" height="125.00" as="geometry"/></mxCell><mxCell id="n41" value="DEFAULT RESULT: No IAM writes. Custom maps can create resources even when default-resource flags remain false.&lt;br&gt;Opt-in CIS policies reference created auditors, security-admins and governance-admins groups. Empty statement lists are filtered by the policy module.&lt;br&gt;No identity domain, federation, MFA configuration, users or security certification is created here." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1000.00" width="2360.00" height="130.00" as="geometry"/></mxCell><mxCell id="n42" value="Arrows describe dependencies / configuration, not application traffic or a validated security outcome.&lt;br&gt;Source review: 2026-10-28. No cloud resources created, no new provider validation, compliance audit or enforcement test.&lt;br&gt;Deployment regions, parent compartment, org and environment are operator inputs. Historical validation dates are unchanged." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1165.00" width="2360.00" height="80.00" as="geometry"/></mxCell><mxCell id="n40" value="Configured group names feed local CIS policy statements" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="840"/><mxPoint x="1980" y="840"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
