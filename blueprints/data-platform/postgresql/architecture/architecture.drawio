Bottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="7.62" y="59.05" width="26.67" height="19.05" as="geometry" /></mxCell><mxCell id="n15" value="" style="vsdxID=715;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="0.00" y="47.62" width="26.67" height="13.33" as="geometry" /></mxCell><mxCell id="n16" value="" style="vsdxID=716;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="19.05" y="24.76" width="5.71" height="5.71" as="geometry" /></mxCell><mxCell id="n17" value="" style="vsdxID=717;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="38.10" y="34.29" width="38.10" height="41.90" as="geometry" /></mxCell><mxCell id="n18" value="NSG / explicit client ingress" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n7"><mxGeometry x="90.00" y="155.00" width="340.00" height="70.00" as="geometry" /></mxCell><mxCell id="n20" value="Ingress-empty security list attached. Public IPs prohibited.&lt;br&gt;No IGW, NAT, SGW or custom route table is created.&lt;br&gt;Client CIDRs: 10.81.0.0/16 default." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n7"><mxGeometry x="40.00" y="310.00" width="1460.00" height="80.00" as="geometry" /></mxCell><mxCell id="n21" value="Reuse an existing subnet/NSG set through input IDs, or create the optional network.&lt;br&gt;Subnet and NSGs are selected independently; review that they belong to the intended VCN." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="50.00" y="570.00" width="1610.00" height="60.00" as="geometry" /></mxCell><mxCell id="n22" value="Database configuration / only when explicitly enabled" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1810.00" y="80.00" width="570.00" height="650.00" as="geometry" /></mxCell><mxCell id="n23" value="enable_db_system=false&lt;br&gt;PostgreSQL version input: 14&lt;br&gt;E5 Flex / 1 instance / 2 OCPU / 32 GiB&lt;br&gt;Regionally durable optimized storage&lt;br&gt;Reader endpoint disabled&lt;br&gt;Management policy enabled&lt;br&gt;Custom backup policy and source default null&lt;br&gt;Credentials: plain text or existing Vault secret&lt;br&gt;Connection details are a read-only data lookup." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n22"><mxGeometry x="25.00" y="80.00" width="520.00" height="490.00" as="geometry" /></mxCell><mxCell id="n24" value="DEFAULT RESULT: No resources; DB system and network flags are false, policy_statements=[].&lt;br&gt;Optional IAM policy uses home-region provider; policy compartment defaults to tenancy root. No Vault/secret is created.&lt;br&gt;Requested size/version/storage settings are source defaults, not quota, availability or compatibility validation. No PostgreSQL traffic or restore was tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n25" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n19" value="TCP 5432 / stateful rules" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resources-oci" name="OCI resources"><mxGraphModel dx="2580" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="1070" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | postgresql" style="text;html=1;whi