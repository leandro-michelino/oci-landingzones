tenancy_ocid      = "ocid1.tenancy.oc1..example"
current_user_ocid = "ocid1.user.oc1..example"
region            = "eu-frankfurt-1"
home_region       = "eu-frankfurt-1"
org               = "acme"
environment       = "dev"
region_key        = "fra"
compartment_ocid  = "ocid1.compartment.oc1..example"

enable_db_system             = false
create_private_network      = true
db_version                   = "14"
shape                        = "PostgreSQL.VM.Standard.E5.Flex"
system_type                  = "OCI_OPTIMIZED_STORAGE"
instance_count               = 1
instance_ocpu_count          = 2
instance_memory_size_in_gbs  = 32
admin_username               = "postgres"
# admin_password             = "replace-with-secure-local-value"
# admin_password_secret_id   = "ocid1.vaultsecret.oc1..example"
subnet_id                    = null
nsg_ids                      = []
vcn_cidr_block               = "10.81.0.0/16"
subnet_cidr_block            = "10.81.10.0/24"
allowed_client_cidrs         = ["10.81.0.0/16"]
is_reader_endpoint_enabled   = false
storage_system_type          = "OCI_OPTIMIZED_STORAGE"
is_regionally_durable        = false
# Required when is_regionally_durable is false.
availability_domain          = "example:REGION-AD-1"
enable_management_policy     = true
backup_policy = {
  backup_start   = "02:00"
  kind           = "DAILY"
  retention_days = 14
}
policy_statements = []
defined_tags      = {}
freeform_tags     = {}
