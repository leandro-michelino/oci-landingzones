00" as="geometry" /></mxCell><mxCell id="n3" value="Contracts / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="290.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n5" value="terraform_data.app_network_contract&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n6" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="870.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n7" value="terraform_data.nosql_contract&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n6"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n8" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="OCI resources"><mxGraphModel dx="2580" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="1290" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | nosql" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="OCI / source-declared resources; conditional declarations remain v