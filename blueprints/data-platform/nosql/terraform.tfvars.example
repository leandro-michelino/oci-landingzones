tenancy_ocid      = "ocid1.tenancy.oc1..example"
current_user_ocid = "ocid1.user.oc1..example"
region            = "eu-madrid-1"
home_region       = "eu-madrid-1"

org         = "acme"
environment = "dev"
region_key  = "mad"

compartment_ocid = "ocid1.compartment.oc1..example"

enable_app_network       = true
app_vcn_cidr             = "10.84.0.0/16"
app_subnet_cidr          = "10.84.10.0/24"
app_ingress_allowed_cidr = "10.0.0.0/8"

table_name             = "acme_dev_mad_db_nosql_orders"
table_ddl_statement    = "CREATE TABLE acme_dev_mad_db_nosql_orders (id STRING, customerId STRING, payload JSON, PRIMARY KEY(id))"
table_max_read_units   = 100
table_max_write_units  = 100
table_max_storage_in_gbs = 25
table_capacity_mode    = "PROVISIONED"

create_secondary_index = true
secondary_index_name   = "acme_dev_mad_db_nosql_customer"
secondary_index_columns = [
  {
    column_name = "customerId"
  }
]

enable_table_replica   = false
replica_region         = null
replica_max_read_units = 100
replica_max_write_units = 100

create_alert_topic = true
alert_topic_name   = "acme-dev-mad-top-nosql-alert"

policy_statements = [
  "Allow group nosql-admins to manage nosql-family in compartment id ocid1.compartment.oc1..example",
  "Allow group nosql-app-rw to use nosql-tables in compartment id ocid1.compartment.oc1..example",
  "Allow group nosql-app-ro to read nosql-tables in compartment id ocid1.compartment.oc1..example"
]

freeform_tags = {
  Owner = "data-platform-team"
}
