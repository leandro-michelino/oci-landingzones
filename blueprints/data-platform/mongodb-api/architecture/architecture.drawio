html=1;whiteSpace=wrap;" vertex="1" parent="n25" connectable="0"><mxGeometry x="0.00" y="0.00" width="82.98" height="70.83" as="geometry" /></mxCell><mxCell id="n27" value="" style="vsdxID=23;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n25" connectable="0"><mxGeometry x="0.00" y="0.00" width="85.00" height="72.86" as="geometry" /></mxCell><mxCell id="n28" value="" style="vsdxID=24;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n25" connectable="0"><mxGeometry x="0.00" y="0.00" width="80.95" height="68.81" as="geometry" /></mxCell><mxCell id="n29" value="Selected database network inputs&lt;br&gt;Explicit subnet_id wins over new subnet fallback&lt;br&gt;Explicit nonempty nsg_ids win over new NSG fallback&lt;br&gt;Endpoint label defaults to mongoapi only when subnet is selected" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1620.00" y="540.00" width="1250.00" height="165.00" as="geometry" /></mxCell><mxCell id="n33" value="Optional manual Autonomous Database backup&lt;br&gt;Database creation AND create_manual_backup (false)" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1620.00" y="880.00" width="1250.00" height="120.00" as="geometry" /></mxCell><mxCell id="n35" value="No gateway or explicit route created.&lt;br&gt;New network can remain unused when explicit&lt;br&gt;existing network overrides are supplied.&lt;br&gt;IAM policy optional / statements=[] / home provider." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="780.00" width="1150.00" height="130.00" as="geometry" /></mxCell><mxCell id="n36" value="DEFAULT RESULT: No resources; private-network, database and manual-backup flags false; IAM statements empty. Eight OCI declarations.&lt;br&gt;Created DB defaults: compute/storage autoscaling, mTLS required, paid non-free tier. KMS ID and backup retention are optional inputs.&lt;br&gt;Public ACL defaults off; private placement requires an actual selected subnet. A disabled database flag does not create a MongoDB API service.&lt;br&gt;No database creation, MongoDB driver compatibility, TCP 27017 connection, certificate validation, backup restore or runtime access was tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1360.00" width="2940.00" height="160.00" as="geometry" /></mxCell><mxCell id="n37" value="Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged.&lt;br&gt;No provisioning, image build/pull, invocation, event delivery, application traffic or cloud test was run." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1570.00" width="2940.00" height="60.00" as="geometry" /></mxCell><mxCell id="n24" value="security_list_ids" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackg