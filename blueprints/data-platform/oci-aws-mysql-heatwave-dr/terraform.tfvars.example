# Base OCI context
tenancy_ocid      = "ocid1.tenancy.oc1..exampleuniqueID"
current_user_ocid = "ocid1.user.oc1..exampleuniqueID"
region            = "eu-frankfurt-1"
home_region       = "eu-frankfurt-1"
oci_config_profile = "DEFAULT"

org         = "acme"
environment = "dev"
region_key  = "eu-frankfurt-1"

# Optional explicit compartment
compartment_ocid = null

# OCI primary network + IPSec
oci_is_primary             = true
enable_oci_primary_network = true
oci_primary_vcn_cidr       = "10.74.0.0/16"
oci_primary_db_subnet_cidr = "10.74.10.0/24"
oci_app_ingress_allowed_cidr = "10.0.0.0/8"

enable_ipsec_connectivity = true
aws_cpe_public_ip         = "203.0.113.10"
aws_bgp_asn               = 64512
aws_replication_cidr      = "10.84.0.0/16"

# OCI MySQL HeatWave primary
create_db_system         = false
existing_db_system_id    = "ocid1.mysqldbsystem.oc1..exampleuniqueID"
create_heatwave_cluster  = false
existing_heatwave_cluster_id = "ocid1.heatwavecluster.oc1..exampleuniqueID"

# Set these only when create_db_system=true
availability_domain     = "kIdk:EU-FRANKFURT-1-AD-1"
fault_domain            = null
mysql_version           = null
db_shape_name           = "MySQL.VM.Standard.E4.1.8GB"
data_storage_size_in_gb = 100
is_highly_available     = true
admin_username          = null
admin_password          = null
backup_enabled          = true
backup_retention_in_days = 7
backup_window_start_time = null

# HeatWave options when create_heatwave_cluster=true
heatwave_shape_name      = "HeatWave.512GB"
heatwave_cluster_size    = 1
enable_heatwave_lakehouse = false

# Optional OCI bucket + alerting
create_lakehouse_bucket = true
lakehouse_bucket_name   = null
kms_key_id              = null
enable_dr_alert_topic   = true
dr_alert_topic_name     = null

# Replication and failover contracts
primary_dns_name        = "mysql-primary.example.internal"
oci_primary_endpoint    = "mysql-primary.oci.internal:3306"
aws_secondary_endpoint  = "mysql-secondary.aws.internal:3306"
replication_user_name   = "replicator"
replication_channel_name = "oci_to_aws_secondary"
replication_ssl_required = true

target_rto_minutes = 30
target_rpo_minutes = 10
dns_ttl_seconds    = 30
dr_drill_frequency = "quarterly"

defined_tags  = {}
freeform_tags = {
  Owner = "platform-team"
}
