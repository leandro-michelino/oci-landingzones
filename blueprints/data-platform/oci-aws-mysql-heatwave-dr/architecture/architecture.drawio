alLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n95"><mxGeometry x="110.00" y="335.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n103" value="" style="shape=mxgraph.aws4.rds_mysql_instance;fillColor=#C925D1;strokeColor=none;" vertex="1" parent="n102" connectable="0"><mxGeometry x="0.00" y="0.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n104" value="CreateRdsStandby=true / MySQL 8.0 / db.t4g.micro / 20 GB&lt;br&gt;Private / MultiAZ=false / encrypted / 7-day backups&lt;br&gt;IAM DB authentication / deletion protection / Performance Insights&lt;br&gt;DB subnet group uses both subnets; SG allows OCI CIDR on 3306" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n95"><mxGeometry x="300.00" y="315.00" width="780.00" height="140.00" as="geometry" /></mxCell><mxCell id="n105" value="Route table + 2 subnet associations; no AWS VPN edge or OCI route.&lt;br&gt;Two AZ subnets do not make the single-AZ RDS instance multi-AZ." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n95"><mxGeometry x="30.00" y="470.00" width="1060.00" height="60.00" as="geometry" /></mxCell><mxCell id="n106" value="VPC flow log / ALL" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n94"><mxGeometry x="121.00" y="726.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n107" value="" style="shape=mxgraph.aws4.flow_logs;fillColor=#8C4FFF;strokeColor=none;" vertex="1" parent="n106" connectable="0"><mxGeometry x="0.00" y="0.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n108" value="30-day encrypted Log Group" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n94"><mxGeometry x="491.00" y="726.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n109" value="" style="shape=mxgraph.aws4.cloudwatch_logs;fillColor=#E7157B;strokeColor=none;" vertex="1" parent="n108" connectable="0"><mxGeometry x="0.00" y="0.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n110" value="KMS key / rotation on" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n94"><mxGeometry x="861.00" y="726.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n111" value="" style="shape=mxgraph.aws4.key_management_service;fillColor=#DD344C;strokeColor=none;" vertex="1" parent="n110" connectable="0"><mxGeometry x="0.00" y="0.00" width="48.00" height="48.00" as="geometry" /></mxCell><mxCell id="n112" value="IAM flow-log role and inline write policy; KMS also used for Performance Insights." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n94"><mxGeometry x="30.00" y="820.00" width="1120.00" height="45.00" as="geometry" /></mxCell><mxCell id="n116" value="AWS VPN edge + OCI return route&lt;br&gt;EXTERNAL prerequisite / not created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n94"><mxGeometry x="40.00" y="620.00" width="440.00" height="70.00" as="geometry" /></mxCell><mxCell id="n122" value="REQUIRED INPUTS: default OCI network/bucket/topic flags are true, but complete DR contracts require both database endpoints (null by default).&lt;br&gt;Five terraform_data contracts record network, connectivity, replication, DNS and runbook intent. RTO 30 min / RPO 10 min / DNS TTL 30 sec are targets only.&lt;br&gt;AWS VPN edge/routes, MySQL seeding/replication and DNS records/cutover remain external steps. No operational cross-cloud path or failover is created or tested.&lt;br&gt;Resource-detail pages enumerate every OCI/AWS declaration, including security, IAM, subnet group, associations and conditional resources." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n113" value="DB attachment" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge=