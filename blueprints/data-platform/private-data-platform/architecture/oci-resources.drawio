30.00" width="5.00" height="8.00" as="geometry"/></mxCell><mxCell id="n176" value="module.streaming.oci_streaming_stream.this&lt;br&gt;oci_streaming_stream&lt;br&gt;for_each = var.enable_streaming ? var.streams : {}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n146"><mxGeometry x="100.00" y="20.00" width="700.00" height="155.00" as="geometry"/></mxCell><mxCell id="n177" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source.&lt;br&gt;Read-only data lookups (not created resources): oci_objectstorage_namespace.this, module.network.module.private_vcn.oci_core_services.all_services, module.network.oci_core_services.all_services" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1560.00" width="2560.00" height="130.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
