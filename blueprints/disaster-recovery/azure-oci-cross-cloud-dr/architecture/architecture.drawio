00" as="geometry" /></mxCell><mxCell id="n86" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="n85" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n87" value="VNet 10.72.0.0/16&lt;br&gt;Container App subnet 10.72.10.0/23, delegated to App environments&lt;br&gt;UDR default → Internet; NSG inbound TCP 80/443" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n84"><mxGeometry x="85.00" y="10.00" width="790.00" height="140.00" as="geometry" /></mxCell><mxCell id="n88" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#312D2A;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n83"><mxGeometry x="30.00" y="340.00" width="890.00" height="180.00" as="geometry" /></mxCell><mxCell id="n89" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n88"><mxGeometry x="25.00" y="70.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n90" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="n89" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n91" value="Managed Environment + Container App&lt;br&gt;External ingress / target port 80 / insecure=false&lt;br&gt;Hello-world image default; replicas 1–2, CPU 0.5 / memory 1Gi&lt;br&gt;Application/data recovery is not configured by this sample." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n88"><mxGeometry x="85.00" y="10.00" width="790.00" height="160.00" as="geometry" /></mxCell><mxCell id="n92" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#312D2A;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n83"><mxGeometry x="30.00" y="650.00" width="890.00" height="110.00" as="geometry" /></mxCell><mxCell id="n93" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n92"><mxGeometry x="25.00" y="35.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n94" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="n93" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n95" value="Log Analytics workspace&lt;br&gt;30-day retention; App environment sends logs to workspace" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n92"><mxGeometry x="85.00" y="10.00" width="790.00" height="90.00" as="geometry" /></mxCell><mxCell id="n98" value="CONTRACTS / DEFAULTS NEED REAL INPUTS&lt;br&gt;Default connectivity_mode=interconnect but FastConnect/ExpressRoute IDs are null. DNS contract enabled but endpoint inputs are null; ingress CIDR is null.&lt;br&gt;These contracts do not provision circuits, DRG, VPN, DNS records or a failover controller. RTO 30 min / RPO 15 min / TTL 30 sec are requested metadata.&lt;br&gt;OCI and Azure are separate deployments; no workload/data replication, automatic DNS switch or tested DR outcome is created." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1120.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n99" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1290.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n43" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n44" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n33"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n96" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroun