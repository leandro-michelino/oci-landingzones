locals {
  common_tags = merge(var.freeform_tags, {
    Lab = "fsdr-real-dr"
  })
}

data "oci_identity_availability_domains" "primary" {
  compartment_id = var.tenancy_ocid
}

data "oci_identity_availability_domains" "standby" {
  provider       = oci.standby
  compartment_id = var.tenancy_ocid
}

data "oci_objectstorage_namespace" "primary" {
  compartment_id = var.tenancy_ocid
}

data "oci_objectstorage_namespace" "standby" {
  provider       = oci.standby
  compartment_id = var.tenancy_ocid
}

resource "oci_core_vcn" "primary" {
  compartment_id = var.compartment_ocid
  cidr_block     = var.primary_vcn_cidr
  display_name   = "${var.name_prefix}-primary-vcn"
  dns_label      = "fsdrp"
  freeform_tags  = local.common_tags
}

resource "oci_core_vcn" "standby" {
  provider       = oci.standby
  compartment_id = var.compartment_ocid
  cidr_block     = var.standby_vcn_cidr
  display_name   = "${var.name_prefix}-standby-vcn"
  dns_label      = "fsdrs"
  freeform_tags  = local.common_tags
}

resource "oci_core_subnet" "primary" {
  compartment_id             = var.compartment_ocid
  vcn_id                     = oci_core_vcn.primary.id
  cidr_block                 = var.primary_subnet_cidr
  display_name               = "${var.name_prefix}-primary-subnet"
  dns_label                  = "primary"
  prohibit_public_ip_on_vnic = true
  freeform_tags              = local.common_tags
}

resource "oci_core_subnet" "standby" {
  provider                   = oci.standby
  compartment_id             = var.compartment_ocid
  vcn_id                     = oci_core_vcn.standby.id
  cidr_block                 = var.standby_subnet_cidr
  display_name               = "${var.name_prefix}-standby-subnet"
  dns_label                  = "standby"
  prohibit_public_ip_on_vnic = true
  freeform_tags              = local.common_tags
}

resource "oci_objectstorage_bucket" "primary" {
  compartment_id = var.compartment_ocid
  namespace      = data.oci_objectstorage_namespace.primary.namespace
  name           = "${var.name_prefix}-primary-bucket"
  access_type    = "NoPublicAccess"
  freeform_tags  = local.common_tags
}

resource "oci_objectstorage_bucket" "standby" {
  provider       = oci.standby
  compartment_id = var.compartment_ocid
  namespace      = data.oci_objectstorage_namespace.standby.namespace
  name           = "${var.name_prefix}-standby-bucket"
  access_type    = "NoPublicAccess"
  freeform_tags  = local.common_tags
}

resource "oci_core_instance" "primary" {
  availability_domain = data.oci_identity_availability_domains.primary.availability_domains[0].name
  compartment_id      = var.compartment_ocid
  display_name        = "${var.name_prefix}-primary-compute"
  shape               = var.instance_shape
  freeform_tags       = local.common_tags

  shape_config {
    ocpus         = var.instance_ocpus
    memory_in_gbs = var.instance_memory_in_gbs
  }

  create_vnic_details {
    subnet_id        = oci_core_subnet.primary.id
    assign_public_ip = false
    hostname_label   = "fsdrprimary"
    display_name     = "${var.name_prefix}-primary-vnic"
  }

  source_details {
    source_type             = "image"
    source_id               = var.image_ocid
    boot_volume_size_in_gbs = var.boot_volume_size_in_gbs
  }
}

resource "oci_core_volume_group" "primary" {
  availability_domain = data.oci_identity_availability_domains.primary.availability_domains[0].name
  compartment_id      = var.compartment_ocid
  display_name        = "${var.name_prefix}-primary-vg"
  freeform_tags       = local.common_tags

  source_details {
    type       = "volumeIds"
    volume_ids = [oci_core_instance.primary.boot_volume_id]
  }

  volume_group_replicas {
    availability_domain = data.oci_identity_availability_domains.standby.availability_domains[0].name
    display_name        = "${var.name_prefix}-standby-vgr"
  }
}
