6.90" width="20.24" height="5.95" as="geometry" /></mxCell><mxCell id="n40" value="" style="vsdxID=105;fillColor=#2d5967;gradientColor=none;shape=stencil(lZFNDoMgEIVPw5bggIWurb2HiVhIKRikf7cvlDRVG23cvRm+eTPhIVoNquklAjIE787yrtugED0gAG2V9DpEhWiNaNU5L0/eXW2b675JZFIXd0sOjzxXEJJmgDw/NYZ345hpo+2IFntcwoQny/DUWHDMy2U47mVidsmKNysw32L/ezgDLHZr92z5l390FN8AOm1Mzm/8Pg8stnLYtH4B);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n33" connectable="0"><mxGeometry x="42.86" y="39.29" width="4.76" height="4.76" as="geometry" /></mxCell><mxCell id="n41" value="" style="vsdxID=106;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n33" connectable="0"><mxGeometry x="2.38" y="0.00" width="44.05" height="44.05" as="geometry" /></mxCell><mxCell id="n42" value="Pool configuration: display/keyboard/pointer on; audio, clipboard, drives, printing and video off.&lt;br&gt;Start/stop schedules null; session lifecycle actions false with disconnect/inactivity inputs null.&lt;br&gt;User onboarding, identity groups, access transport and application targets remain external." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="600.00" y="735.00" width="1000.00" height="110.00" as="geometry" /></mxCell><mxCell id="n43" value="DEFAULT RESULT: No cloud resources; pool disabled, alarms empty and policy statements empty. Image, network, AD and backup-policy selections are operator inputs.&lt;br&gt;Private-access details are pool configuration, not a created VCN, subnet, NSG, VPN or standalone endpoint. No user-to-desktop or application data path is invented.&lt;br&gt;An existing desktop_pool_id is only an output/reference fallback; this code does not attach new policies or configuration to an existing pool.&lt;br&gt;Historical provider validation is unchanged." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n8" value="image configuration" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n10" value="Pool private-access configuration" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n12" value="storage_backup_policy_id / optional" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="480" /><mxPoint x="1640" y="387.5" /></Array></mxGeometry></mxCell><mxCell id="n32" value="destinations / explicit IDs" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;en