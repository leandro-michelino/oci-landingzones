<mxfile host="ocidraw" type="device"><diagram id="oci" name="Hospital integration and FHIR | Private API mediation and optional event queue"><mxGraphModel dx="2760" dy="1485" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2800" pageHeight="1525" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Hospital integration and FHIR | Private API mediation and optional event queue" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2740.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Source-defined OCI infrastructure / External FHIR server, identity and clinical adapters / All cloud creation disabled by default" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="70.00" width="2740.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Solid: declared routes, API backend/token validation or logging. Plain: bindings. Dashed: external transport / middleware / workflow. No line proves runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="112.00" width="2740.00" height="30.00" as="geometry" /></mxCell><mxCell id="n4" value="Existing hospital / approved backend environment / location verified by operator" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyl