/S7Cx+AWh134f8LN/XgZlbIWxUfQA=);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n146" connectable="0"><mxGeometry x="34.00" y="16.00" width="5.00" height="8.00" as="geometry" /></mxCell><mxCell id="n160" value="" style="vsdxID=175;fillColor=#2d5967;gradientColor=none;shape=stencil(nZLNDoMgEISfhutmWaTi2bbvYSJWUisG7d/bV8qh0qQYe9tdvplMwjBRjm01aEY4Ts6e9d3UU8vEnhGZvtXOTPPExIGJsrFOn5y99nXYh8qTfrrYm3d4BB16BeEzbCoH3L0vxwB3pl/AvAAhIwFHTOAYu0sEWfzGiQNXkSDhTYBZnIRDnoieKcA8EmQJd/yTlAoUbQmxItj0OyvwPHxK0JiuCx1avn+XZj6FwonDCw==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n146" connectable="0"><mxGeometry x="34.00" y="4.00" width="5.00" height="8.00" as="geometry" /></mxCell><mxCell id="n161" value="" style="vsdxID=176;fillColor=#2d5967;gradientColor=none;shape=stencil(nZLdDoMgDIWfhtumULbgtXPvYSJOMicGdT9vPxlLpi7DuLtD+U7TwmGUdlXeaiaw650965sp+orRgQlhmko704+KUcYoLa3TJ2eHpgjnNvekVxd79R3uwcdBSW8S+HgXOCSvwjHgtWkmuFTA9zNeIkj124D/wzsFRFtGWTHMuysFGFmUJ8DV/GEQIzguZo+xX61j8Lb/WcVH8YlCaeo6JGl6v4zOWAqxo+wJ);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n146" connectable="0"><mxGeometry x="34.00" y="29.00" width="5.00" height="8.00" as="geometry" /></mxCell><mxCell id="n162" value="oci_queue_queue.integration&lt;br&gt;oci_queue_queue&lt;br&gt;count = local.queue ? 1 : 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n145"><mxGeometry x="100.00" y="20.00" width="700.00" height="155.00" as="geometry" /></mxCell><mxCell id="n163" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source.&lt;br&gt;Read-only data lookups (not created resources): oci_core_services.regional" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1340.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-2" name="Existing resources / inputs"><mxGraphModel dx="2560" dy="755" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2600" pageHeight="795" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Existing resources and overrides | healthcare-fhir-integration" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Source-declared identifier inputs / not created resources / no live inventory or private tfvars read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="" style="whiteSpace=