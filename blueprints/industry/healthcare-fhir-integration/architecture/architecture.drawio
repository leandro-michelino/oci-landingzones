=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n105" connectable="0"><mxGeometry x="27.91" y="20.93" width="9.77" height="9.77" as="geometry" /></mxCell><mxCell id="n123" value="" style="vsdxID=42;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n105" connectable="0"><mxGeometry x="39.07" y="20.93" width="8.37" height="9.77" as="geometry" /></mxCell><mxCell id="n124" value="" style="vsdxID=43;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n105" connectable="0"><mxGeometry x="25.12" y="11.16" width="27.91" height="27.91" as="geometry" /></mxCell><mxCell id="n127" value="No IGW, NAT, public endpoint or Internet default route.&lt;br&gt;Hospital transport, private DNS, clinical authorization and adapters need separate implementation and testing." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="50.00" y="990.00" width="1880.00" height="45.00" as="geometry" /></mxCell><mxCell id="n128" value="DEFAULTS: enable_foundation/api/queue=false; costs_approved=false. Local guard + FHIR metadata contracts only.&lt;br&gt;API requires approved client/backend/JWKS prefixes, HTTPS URLs, issuer/audience values, existing DRG and acknowledged backend authorization. Queue is independently enabled with an existing KMS key.&lt;br&gt;FHIR server software, persistence, SMART scopes, consent, HL7 mappings, event workers, replay and clinical audit are not created. The patient-data blueprint remains an independent project.&lt;br&gt;Source/schema review 2026-10-28: oracle/oci 9.11.0; 11 mocked plans passed. No apply, token exchange, FHIR transaction, mapping or end-to-end interoperability test." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1330.00" width="2740.00" height="155.00" as="geometry" /></mxCell><mxCell id="n32" value="gateway_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n18" target="n31"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n34" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="322.5" /><mxPoint x="850" y="497" /></Array></mxGeometry></mxCell><mxCell id="n75" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n38"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320.0" y="705" /><mxPoint x="1100" y="705" /></Array></mxGeometry></mxCell><mxCell id="n76" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;