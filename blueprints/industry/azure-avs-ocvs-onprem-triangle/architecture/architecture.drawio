<mxfile host="ocidraw" type="device"><diagram id="oci" name="VMware triangle | On-premises, OCVS and AVS with three independent legs"><mxGraphModel dx="2960" dy="1880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="1920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="VMware triangle | On-premises, OCVS and AVS with three independent legs" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2940.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Plain: declared ID/config associations. Solid: optional circuit intent. Dashed: external prerequisites or proposed apps. No runtime evidence." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="85.00" width="2940.00" height="45.00" as="geometry" /></mxCell><mxCell id="n3" value="On-premises VMware / existing and externally operated" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="160.00" width="900.00" height="900.00" as="geometry" /></mxCell><mxCell id="n4" value="Existing vCenter + ESXi / vSAN or selected storage&lt;br&gt;NSX / VM networks / guest VMs&lt;br&gt;Versions, licensing, capacity and support require review" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontS