e / separately deployed Bicep / approved region and quota" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="2060.00" y="160.00" width="900.00" height="900.00" as="geometry" /></mxCell><mxCell id="n32" value="AVS private cloud / createPrivateCloud=false&lt;br&gt;Or existing same-RG AVS / management + workload networks&lt;br&gt;AV36 + 3 hosts + /22 are reviewable examples" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n31"><mxGeometry x="417.50" y="137.50" width="65.00" height="65.00" as="geometry" /></mxCell><mxCell id="n33" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="n32" connectable="0"><mxGeometry x="0.00" y="0.00" width="65.00" height="65.00" as="geometry" /></mxCell><mxCell id="n34" value="HCX add-on / enableHcxAddon=false&lt;br&gt;Explicit offer + management/uplink networks" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n31"><mxGeometry x="40.00" y="255.00" width="820.00" height="70.00" as="geometry" /></mxCell><mxCell id="n36" value="AVS-managed ExpressRoute circuit&lt;br&gt;Part of AVS / no standalone customer circuit resource" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n31"><mxGeometry x="40.00" y="365.00" width="820.00" height="90.00" as="geometry" /></mxCell><mxCell id="n38" value="Optional AVS Global Reach attachment + ER authorization&lt;br&gt;connectAvsToOci / costs + region + address-plan gates&lt;br&gt;avsTransitVerified=false / exact pairing support pending" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n31"><mxGeometry x="40.00" y="545.00" width="820.00" height="110.00" as="geometry" /></mxCell><mxCell id="n40" value="Customer Oracle-facing ExpressRoute&lt;br&gt;createInterconnectCircuit=false / provider service key&lt;br&gt;Private peering completed by partner provisioning" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n31"><mxGeometry x="420.00" y="730.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n41" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="n40" connectable="0"><mxGeometry x="0.00" y="0.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n47" value="Second AVS Global Reach attachment / onprem-direct&lt;br&gt;connectOnpremToAvs + approved + onpremGlobalReachVerified&lt;br&gt;Existing separate onpremCircuitId + secure authorization key" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="2060.00" y="1140.00" width="900.00" height="130.00" as="geometry" /></mxCell><mxCell id="n50" value="PROPOSED GENERIC WORKLOAD / Start onprem, pilot on AVS, final target OCVS; keep each active stack colocated / NOT deployed or tested" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="1370.00" width="2940.00" height="40.00" as="geometry" /></mxCell><mxCell id="n51" value="Client / browser&lt;br&gt;Existing private entry / HTTPS 443" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1445.00" width="635.00" height="115.00" as="geometry" /></mxCell><mxCell id="n52" value="NGINX web VM&lt;br&gt;Linux / TLS termination + proxy" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="755.00" y="1445.00" width="635.00" height="115.00" as="geometry" /></mxCell><mxCell id="n53" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n52"><mxGeometry x="14.00" y="41.50" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n54" value="" style="shape=mxgraph.vvd.virtual_machine;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="n53" connectable="0"><mxGeometry x="0.00" y="0.00" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n55" value="Spring Boot API VM&lt;br&gt;Linux / identity and secrets required" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor