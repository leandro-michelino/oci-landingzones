ight="150.00" as="geometry" /></mxCell><mxCell id="n10" value="Existing edge router / firewall / carrier handoff&lt;br&gt;DNS + NTP / HCX activation and update egress&lt;br&gt;Separate on-premises FastConnect and ExpressRoute legs" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="40.00" y="640.00" width="820.00" height="120.00" as="geometry" /></mxCell><mxCell id="n13" value="OCI / explicit compartment and selected region / opt-in" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F4F2;rounded=1;arcSize=2;absoluteArcSize=0;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;spacingLeft=6;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1040.00" y="160.00" width="900.00" height="900.00" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;Existing prepared OCVS VCN / CIDRs TBC&lt;/b&gt;" style="whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;spacingTop=2;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n13"><mxGeometry x="40.00" y="80.00" width="820.00" height="600.00" as="geometry" /></mxCell><mxCell id="n15" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;dashed=1;dashPattern=1 1;strokeColor=#bb511c;strokeWidth=3;fontColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n14"><mxGeometry x="780.57" y="-15.00" width="31.43" height="30.00" as="geometry" /></mxCell><mxCell id="n16" value="OCVS SDDC / enable_sddc=false&lt;br&gt;MANAGEMENT + explicit WORKLOAD clusters / dense-vSAN&lt;br&gt;ESXi / vCenter / N