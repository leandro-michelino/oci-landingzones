dth="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n28" value="var.replication_vlan_id&lt;br&gt;Optional existing Replication-Net VLAN; supply when the selected VMware bundle&lt;br&gt;requires it.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n27"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n29" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="1060.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n30" value="var.hcx_vlan_id&lt;br&gt;Existing HCX VLAN, required only when HCX is enabled.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n29"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n31" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1720.00" y="1060.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n32" value="var.workload_clusters&lt;br&gt;Explicit initial WORKLOAD clusters; at least one is required for SDDC creation. Each&lt;br&gt;reuses its own provisioning subnet and VLAN IDs inside the selected VCN. Shape, AD,&lt;br&gt;bundle and commitment use the common inputs.&lt;br&gt;Default expression: {}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n31"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n33" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1290.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n34" value="var.circuits&lt;br&gt;One explicit partner circuit configuration per required site role; keys azure and/or&lt;br&gt;onprem as documented. Service keys can be sensitive; use ignored inputs.&lt;br&gt;Default expression: {}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n33"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n35" value="These inputs identify separately managed resources or override a default selection. The overview and module call-site decide their use.&lt;br&gt;Null/empty defaults do not prove that an external resource exists. Input names and defaults are source contracts, not discovered cloud inventory.&lt;br&gt;Collection inputs can contain further resource references; consult their source schemas and the overview prerequisites. No ownership adoption is implied." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1545.00" width="2540.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
