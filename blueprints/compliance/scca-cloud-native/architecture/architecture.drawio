ing, Budgets and OS Management are disabled. No accreditation is implied." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1300.00" width="1680.00" height="95.00" as="geometry" /></mxCell><mxCell id="n176" value="Core + operations detail / source-defined enablement" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1760.00" y="160.00" width="740.00" height="1080.00" as="geometry" /></mxCell><mxCell id="n177" value="module.core / pinned Core, cis_level=level2&lt;br&gt;Creates root + governance/security/network/workloads compartments,&lt;br&gt;6 default IAM groups, 2 dynamic groups, scoped policies, tags and log groups." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n176"><mxGeometry x="20.00" y="70.00" width="700.00" height="100.00" as="geometry" /></mxCell><mxCell id="n178" value="Cloud Guard&lt;br&gt;Enabled" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n176"><mxGeometry x="92.00" y="255.26" width="56.00" height="49.49" as="geometry" /></mxCell><mxCell id="n179" value="" style="vsdxID=120;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=non