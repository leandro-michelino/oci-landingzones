<mxfile host="ocidraw" type="device"><diagram id="oci" name="WAF | Optional empty policy and existing Load Balancer attachment"><mxGraphModel dx="2480" dy="1385" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2520" pageHeight="1425" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="WAF | Optional empty policy and existing Load Balancer attachment" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2460.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="EXTENSIONS 47 / Official OCI Toolkit v24.2 / Source configuration only / No cloud operations" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2460.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Plain: ID/configuration association. Solid arrow: configured route intent. Dashed: external prerequisite. No line proves working traffic." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="108.00" width="2460.00" height="30.00" as="geometry" /></mxCell><mxCell id="n4" value="OCI / selected region and compartment; tenancy fallback requires review" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F4F2;rounded=1;arcSize=2;absoluteArcSize=0;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;spacingLeft=6;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="160.00" width="2460.00" height="900.00" as="geometry" /></mxCell><mxCell id="n5" value="Optional new WAF policy / enable_waf_policy=false&lt;br&gt;Compartment, display name and tags only&lt;br&gt;No access/protection/rate-limit rules or actions declared" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="240.00" width="690.00" height="145.00" as="geometry" /></mxCell><mxCell id="n6" value="Existing policy override / waf_policy_id=null&lt;br&gt;Explicit ID takes precedence over the newly created policy&lt;br&gt;Existing policy rules are not inspected or changed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="565.00" width="690.00" height="130.00" as="geometry" /></mxCell><mxCell id="n7" value="Optional Web App Firewall attachment&lt;br&gt;enable_web_app_firewall=false&lt;br&gt;backend_type=LOAD_BALANCER" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n4"><mxGeometry x="1157.50" y="259.48" width="85.00" height="81.05" as="geometry" /></mxCell><mxCell id="n8" value="" style="vsdxID=177;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="83.02" height="79.07" as="geometry" /></mxCell><mxCell id="n9" value="" style="vsdxID=178;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="85.00" height="81.05" as="geometry" /></mxCell><mxCell id="n10" value="" style="vsdxID=180;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="81.05" height="39.53" as="geometry" /></mxCell><mxCell id="n11" value="" style="vsdxID=181;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="31.63" y="21.74" width="39.53" height="53.37" as="geometry" /></mxCell><mxCell id="n12" value="Existing Load Balancer / load_balancer_id=null&lt;br&gt;No LB, listener, backend set, certificate or application created" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n4"><mxGeometry x="2060.00" y="260.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n13" value="" style="vsdxID=8;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n12" connectable="0"><mxGeometry x="0.00" y="0.00" width="78.10" height="78.10" as="geometry" /></mxCell><mxCell id="n14" value="" style="vsdxID=9;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n12" connectable="0"><mxGeometry x="0.00" y="0.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n15" value="" style="vsdxID=10;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n12" connectable="0"><mxGeometry x="1.90" y="1.90" width="76.19" height="76.19" as="geometry" /></mxCell><mxCell id="n19" value="Attachment preconditions require both an existing Load Balancer ID and an effective policy ID.&lt;br&gt;The policy is configuration associated with the attachment, not a separate packet-forwarding hop.&lt;br&gt;No Internet ingress, request protection rule, logging, alarm or protected application traffic is inferred." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1000.00" y="650.00" width="1380.00" height="170.00" as="geometry" /></mxCell><mxCell id="n20" value="DEFAULT RESULT: No resources; both WAF flags false. Two resource declarations: optional policy and optional Load Balancer attachment.&lt;br&gt;An explicit existing policy ID wins even if policy creation is also enabled. The newly created policy can therefore remain unused.&lt;br&gt;The policy declaration has no rule blocks. Creation or association alone is not evidence of configured protection, origin reachability or blocked attacks.&lt;br&gt;No request, rule evaluation, false-positive assessment, TLS behavior, logging or live protection test was run.&lt;br&gt;Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged; no provisioning or runtime test was run." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n21" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n16" value="Created policy fallback / only if waf_policy_id=null" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="460" /><mxPoint x="1050" y="472.5" /></Array></mxGeometry></mxCell><mxCell id="n17" value="Explicit policy ID / if supplied" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="790" /></Array></mxGeometry></mxCell><mxCell id="n18" value="load_balancer_id / attachment association" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | waf" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="OCI / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="290.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n5" value="oci_waf_web_app_firewall_policy.this&lt;br&gt;oci_waf_web_app_firewall_policy&lt;br&gt;count = var.enable_waf_policy ? 1 : 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n6" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="870.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n7" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n6"><mxGeometry x="34.00" y="69.98" width="42.00" height="40.05" as="geometry" /></mxCell><mxCell id="n8" value="" style="vsdxID=177;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="41.02" height="39.07" as="geometry" /></mxCell><mxCell id="n9" value="" style="vsdxID=178;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="42.00" height="40.05" as="geometry" /></mxCell><mxCell id="n10" value="" style="vsdxID=180;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.05" height="19.53" as="geometry" /></mxCell><mxCell id="n11" value="" style="vsdxID=181;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n7" connectable="0"><mxGeometry x="15.63" y="10.74" width="19.53" height="26.37" as="geometry" /></mxCell><mxCell id="n12" value="oci_waf_web_app_firewall.this&lt;br&gt;oci_waf_web_app_firewall&lt;br&gt;count = var.enable_web_app_firewall ? 1 : 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n6"><mxGeometry x="100.00" y="20.00" width="700.00" height="155.00" as="geometry" /></mxCell><mxCell id="n13" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="Existing resources / inputs"><mxGraphModel dx="2560" dy="525" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2600" pageHeight="565" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Existing resources and overrides | waf" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Source-declared identifier inputs / not created resources / no live inventory or private tfvars read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n4" value="var.compartment_ocid&lt;br&gt;Compartment OCID where WAF resources are created. Defaults to tenancy_ocid for&lt;br&gt;validation-only tests.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n5" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n6" value="var.waf_policy_id&lt;br&gt;Existing WAF policy OCID used when attaching a firewall to an existing policy.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n7" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1720.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n8" value="var.load_balancer_id&lt;br&gt;Load balancer OCID protected by the Web App Firewall.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n7"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n9" value="These inputs identify separately managed resources or override a default selection. The overview and module call-site decide their use.&lt;br&gt;Null/empty defaults do not prove that an external resource exists. Input names and defaults are source contracts, not discovered cloud inventory.&lt;br&gt;Collection inputs can contain further resource references; consult their source schemas and the overview prerequisites. No ownership adoption is implied." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="395.00" width="2540.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
