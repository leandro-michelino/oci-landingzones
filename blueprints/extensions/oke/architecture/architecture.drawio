1" parent="n7" connectable="0"><mxGeometry x="8.93" y="33.93" width="55.36" height="28.57" as="geometry" /></mxCell><mxCell id="n17" value="Existing worker subnets / node_subnet_ids=[]" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="1270.00" y="90.00" width="1060.00" height="250.00" as="geometry" /></mxCell><mxCell id="n18" value="Node pool / enable_node_pool=false&lt;br&gt;Created cluster fallback or supplied cluster_id&lt;br&gt;1 node per subnet / shape, version and image inputs null" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n17"><mxGeometry x="60.00" y="100.00" width="940.00" height="100.00" as="geometry" /></mxCell><mxCell id="n20" value="Existing service-LB subnet IDs / []&lt;br&gt;Only cluster options.service_lb_subnet_ids&lt;br&gt;No Load Balancer or Kubernetes Service created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="40.00" y="435.00" width="1000.00" height="125.00" as="geometry" /></mxCell><mxCell id="n22" value="Cluster CNI input: OCI_VCN_IP_NATIVE. Kubernetes version is operator supplied.&lt;br&gt;Endpoint NSGs=[]; no security rules, route tables, gateways or IAM are created.&lt;br&gt;An endpoint subnet is optional in code; the false public-IP flag alone does not&lt;br&gt;create an API subnet, private endpoint or a working operator access path." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="1270.00" y="420.00" width="1060.00" height="160.00" as="geometry" /></mxCell><mxCell id="n23" value="Worker subnet, image and shape choices are explicit inputs; no autoscaling, workload, ingress controller or image registry is deployed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="50.00" y="790.00" width="2320.00" height="65.00" as="geometry" /></mxCell><mxCell id="n24" value="DEFAULT RESULT: No resources. enable_cluster=false and enable_node_pool=false. Exactly two resource declarations, with existing-resource identifier references.&lt;br&gt;Endpoint configuration is emitted only when endpoint_subnet_id is non-null. CIDRs and actual existing network exposure are not inferred.&lt;br&gt;Node pool uses the selected cluster and supplied worker subnets. Network reachability, compatible image/version, IAM and application manifests require separate review.&lt;br&gt;No cluster, nodes, pods, service Load Balancer, private access, autoscaling or runtime Kubernetes connection was provisioned or tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n25" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n19" value="cluster_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n21" value="Optional service-LB subnet configuration" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | oke" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sa