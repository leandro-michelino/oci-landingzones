" height="13.33" as="geometry" /></mxCell><mxCell id="n34" value="Existing pool override / stream_pool_id=null&lt;br&gt;Explicit ID takes precedence over a created pool&lt;br&gt;No existing pool configuration is changed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1560.00" y="130.00" width="840.00" height="140.00" as="geometry" /></mxCell><mxCell id="n35" value="Pool-bound streams / stream map entries&lt;br&gt;enable_streaming AND (create_stream_pool OR supplied ID)&lt;br&gt;Per-entry partitions + optional retention" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="440.00" width="1100.00" height="140.00" as="geometry" /></mxCell><mxCell id="n36" value="Alternative compartment-scoped streams&lt;br&gt;enable_streaming AND NOT create_stream_pool AND no pool ID&lt;br&gt;No explicit pool association in this declaration" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1350.00" y="440.00" width="1000.00" height="140.00" as="geometry" /></mxCell><mxCell id="n39" value="Optional created-pool settings / existing identifiers only&lt;br&gt;private_endpoint_subnet_id=null / private_endpoint_nsg_ids=[]&lt;br&gt;kms_key_id=null / no network, NSG or key created&lt;br&gt;kafka_settings=null / nested pool settings, not another service" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="690.00" width="1100.00" height="145.00" as="geometry" /></mxCell><mxCell id="n41" value="Three declarations: optional pool plus two mutually exclusive stream branches.&lt;br&gt;No producer, consumer, source data, topic ingestion worker, IAM grant or&lt;br&gt;packet path is created. Existing pool override affects stream placement only;&lt;br&gt;a separately enabled new pool can still be created and remain unused." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1350.00" y="690.00" width="1000.00" height="150.00" as="geometry" /></mxCell><mxCell id="n42" value="DEFAULT RESULT: No resources; enable_streaming=false and streams empty. create_stream_pool=true is gated by enable_streaming.&lt;br&gt;Pool-bound and compartment-scoped stream declarations never create the same map entry together. Source partitions/retention are per stream.&lt;br&gt;Plain lines show configured IDs only. Private endpoint settings are emitted only with an existing subnet ID; no VCN/subnet/NSG/route or KMS key is created." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n37" value="stream_pool_id / created fallback only if supplied ID=null" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n35" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n38" value="stream_pool_id / explicit override if non-null" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n35" target="n34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="649" /><mxPoint x="1240" y="360" /></Array></mxGeometry></mxCell><mxCell id="n40" value="Optional private_endpoint_settings / custom_encryption_key" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="45" y="360" /><mxPoint x="45" y="922.5" /></Array><mxPoint x="250" y="0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="425" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="465" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | streaming" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="OCI / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="290.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n5" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="34.00" y="69.00" width="42.00" height="42.00" as="geometry" /></mxCell><mxCell id="n6" value="" style="vsdxID=80;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n5" connectable="0"><mxGeometry x="0.00" y="0.00" width="41.00" height="41.00" as="geometry" /></mxCell><mxCell id="n7" value="" style="vsdxID=81;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wra