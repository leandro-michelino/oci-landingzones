le="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n5"><mxGeometry x="660.00" y="240.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n17" value="" style="shape=mxgraph.gcp2.container_engine;fillColor=#4285F4;strokeColor=none;" vertex="1" parent="n16" connectable="0"><mxGeometry x="0.00" y="0.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n19" value="Existing OKE network prerequisites&lt;br&gt;oci_vcn_id + oci_subnet_id / explicit node_subnet_ids&lt;br&gt;API, node, pod, service and load-balancer security/egress&lt;br&gt;Runner connectivity and OCI service access must be prepared" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="650.00" width="1200.00" height="170.00" as="geometry" /></mxCell><mxCell id="n21" value="Created VPC + private subnet / flow logs&lt;br&gt;Named pod range 10.97.0.0/16 + service range 10.98.0.0/20&lt;br&gt;Control-plane example 172.28.0.0/28 / check overlap&lt;br&gt;Optional NAT is separately billed / private API access needs routes" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="650.00" width="1200.00" height="170.00" as="geometry" /></mxCell><mxCell id="n23" value="Cross-cloud network, DNS, application ingress, identity federation, data consistency and weighted routing are external. No automatic failover or RPO/RTO is installed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="1010.00" width="1200.00" height="80.00" as="geometry" /></mxCell><mxCell id="n24" value="DEFAULT RESULT: No cloud resources; cost and creation/workload flags false. Local metadata guards remain. Separate roots and credentials for each cloud.&lt;br&gt;Native detail pages enumerate every root/module/companion declaration, including private networking, flow logs, IAM and service-specific dependencies.&lt;br&gt;Existing projects/APIs, scoped credentials, region eligibility, quota, supported images/versions, address plans, routes and DNS are explicit prerequisites.&lt;br&gt;Only local schema/mocked configuration and diagram checks were run. No provisioning, billing acceptance, connectivity, replication, failover or workload execution was performed." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1360.00" width="2940.00" height="160.00" as="geometry" /></mxCell><mxCell id="n25" value="Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged.&lt;br&gt;No provisioning, image build/pull, invocation, event delivery, application traffic or cloud test was run." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1570.00" width="2940.00" height="60.00" as="geometry" /></mxCell><mxCell id="n18" value="External image / manifest / state replication, recovery and DNS cutover" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n20" value="Network and worker placement identifiers" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n22" value="network / subnetwork / secondary range bindings" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="Contracts resources"><mxGraphModel dx="2580" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Contracts resources | gke-oke-active-passive" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Contracts / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="290.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n5" value="terraform_data.guard&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n6" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="870.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n7" value="gcp.module.network.terraform_data.guard&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n6"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n8" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="1720.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n9" value="gcp.terraform_data.guard&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n8"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n10" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="GCP resources"><mxGraph