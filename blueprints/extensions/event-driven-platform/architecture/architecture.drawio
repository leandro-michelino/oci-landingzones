ents action requires matching conditions, service permissions and reachable targets. FAAS IDs, OSS stream IDs/keys and ONS topics are independently supplied.&lt;br&gt;Service Connector selects one target kind: objectStorage default, or supplied Function/stream/topic. Explicit target bucket/namespace override fallback values.&lt;br&gt;The bucket-name fallback can exist even when bucket creation is disabled; an existing bucket/namespace must actually exist." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1360.00" width="2940.00" height="160.00" as="geometry" /></mxCell><mxCell id="n40" value="Optional FAAS action / declared function_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n41" value="Optional ONS action / explicit topic_id or selected fallback" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="368" /><mxPoint x="980" y="470" /><mxPoint x="2520" y="470" /></Array></mxGeometry></mxCell><mxCell id="n43" value="Optional OSS action / supplied stream ID or stream_key" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#F