wpyVA1dlE1MsrMy0gtyiwBslSNXVWNndPyi1LTi/JL81Ig/IJEkEoQKze/DGRCBUSfAUiHkUElMs8NojAnMw+nQktDPTNi1Roa4DEWJkmWYvyuQFdNtOfIUwhkIAI5LTMnBxJHyPLokQIUgkSosSsA);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n5" connectable="0"><mxGeometry x="48.37" y="33.49" width="1.86" height="18.60" as="geometry" /></mxCell><mxCell id="n14" value="Existing optional service identifiers&lt;br&gt;kms_key_id=null / domain_id=null&lt;br&gt;No key or identity domain created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1420.00" y="155.00" width="930.00" height="150.00" as="geometry" /></mxCell><mxCell id="n16" value="Private access channel / enable_private_access_channel=false&lt;br&gt;Created instance if enabled; else existing_analytics_instance_id&lt;br&gt;private_source_dns_zones=[] / DNS zone descriptors only" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="510.00" width="1090.00" height="160.00" as="geometry" /></mxCell><mxCell id="n18" value="Existing VCN + subnet + NSGs&lt;br&gt;vcn_id=null / subnet_id=null / NSGs=[]&lt;br&gt;No network or DNS zone is created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1420.00" y="510.00" width="930.00" height="160.00" as="geometry" /></mxCell><mxCell id="n20" value="The private access channel is a separate instance attachment using supplied network IDs.&lt;br&gt;No data source, data connection, dataset, workbook, agent, ingress endpoint or content migration is declared.&lt;br&gt;email_notification is an instance property; no notification subscription or delivery path is created." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="750.00" width="2320.00" height="105.00" as="geometry" /></mxCell><mxCell id="n21" value="DEFAULT RESULT: No resources; both creation flags false. Two resource declarations, with optional existing-instance fallback.&lt;br&gt;Private source DNS zone entries do not create OCI DNS zones or resolver rules. A private channel does not establish an application/data-source connection.&lt;br&gt;No Analytics UI access, private DNS, data source authentication, query, workbook, encryption entitlement or cloud deployment was tested.&lt;br&gt;Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged; no provisioning or runtime test was run." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n22" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell