l><mxCell id="n22" value="API deployment / enable_deployment=false&lt;br&gt;path_prefix=/ / routes=[]&lt;br&gt;Existing gateway_id takes precedence; otherwise created gateway ID" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1260.00" y="365.00" width="1100.00" height="135.00" as="geometry" /></mxCell><mxCell id="n24" value="Existing gateway_id / null by default&lt;br&gt;Explicit ID overrides the created gateway for deployment" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="470.00" width="850.00" height="100.00" as="geometry" /></mxCell><mxCell id="n26" value="Supplied per-route backend configuration / EXTERNAL TARGETS&lt;br&gt;backend_type + optional URL or status / methods + timeouts&lt;br&gt;No backend resource, client, authentication policy or application created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1260.00" y="665.00" width="1100.00" height="150.00" as="geometry" /></mxCell><mxCell id="n28" value="Routes may describe URL backends or status-based responses.&lt;br&gt;The solid arrow describes configured handling, not a guaranteed&lt;br&gt;network request to a backend for every backend type.&lt;br&gt;No ingress, DNS, TLS, IAM or backend readiness is verified." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="60.00" y="620.00" width="1050.00" height="165.00" as="geometry" /></mxCell><mxCell id="n29" value="DEFAULT RESULT: No resources; gateway and deployment flags are false. Two independent resource declarations.&lt;br&gt;An existing gateway_id overrides the created gateway for deployment binding; resource_ids.gateway reports only a newly created gateway.&lt;br&gt;PUBLIC is a source default, not evidence of Internet reachability. Subnet routes, NSG rules, certificates, backend reachability and authentication require separate implementation." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n19" value="subnet_id / network_security_group_ids" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n21" value="Optional certificate_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="356" /><mxPoint x="1160" y="552.5" /></Array></mxGeometry></mxCell><mxCell id="n23" value="Created gateway fallback / only when gateway_id=null" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.4;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n25" value="Explicit gateway_id / if non-null" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="633" /><mxPoint x="1220" y="680" /></Array></mxGeometry></mxCell><mxCell id="n27" value="Configured route intent / only populated routes" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n26"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="425" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="465" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | apigw" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for to