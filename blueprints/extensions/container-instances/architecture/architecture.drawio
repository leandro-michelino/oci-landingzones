cSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="1100.00" y="130.00" width="1200.00" height="140.00" as="geometry" /></mxCell><mxCell id="n18" value="Nested VNIC / existing subnet + nsg_ids=[]&lt;br&gt;Public IP=false / private_ip=null / skip_source_dest_check=false&lt;br&gt;No subnet, NSG, route, gateway or standalone VNIC resource" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="40.00" y="400.00" width="900.00" height="120.00" as="geometry" /></mxCell><mxCell id="n20" value="Optional instance settings / input collections empty&lt;br&gt;image_pull_secrets: existing registry endpoint / optional Vault secret ID&lt;br&gt;Custom DNS + volumes[] / CONFIGFILE or supplied type/backing store&lt;br&gt;No registry, secret, DNS server or durable-volume resource created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="1100.00" y="400.00" width="1200.00" height="120.00" as="geometry" /></mxCell><mxCell id="n22" value="Independent optional IAM policy / statements=[]&lt;br&gt;Regional provider / policy compartment defaults to tenancy" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n4"><mxGeometry x="2122.50" y="753.15" width="55.00" height="53.69" as="geometry" /></mxCell><mxCell id="n23" value="" style=