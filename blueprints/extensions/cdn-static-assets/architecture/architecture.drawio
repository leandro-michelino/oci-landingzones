<mxfile host="ocidraw" type="device"><diagram id="oci" name="CDN static assets | Optional Cloudflare edge and private OCI origin"><mxGraphModel dx="2960" dy="1630" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="1670" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="CDN static assets | Optional Cloudflare edge and private OCI origin" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2940.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Official OCI Toolkit v24.2 / Named Cloudflare resources where no exact native glyph is available / Source configuration only" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2940.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Plain: ID/config association. Solid arrow: configured request intent. Dashed: external prerequisite. No line proves working traffic." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="108.00" width="2940.00" height="30.00" as="geometry" /></mxCell><mxCell id="n4" value="Cloudflare / supplied account and zone; independently enabled resources" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="160.00" width="1400.00" height="1120.00" as="geometry" /></mxCell><mxCell id="n5" value="OCI / selected region and compartment; tenancy fallback requires review" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F4F2;rounded=1;arcSize=2;absoluteArcSize=0;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;spacingLeft=6;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1560.00" y="160.00" width="1400.00" height="1120.00" as="geometry" /></mxCell><mxCell id="n6" value="Optional Worker route / create_cloudflare_worker_proxy=false&lt;br&gt;Zone + supplied pattern, or hostname + smoke path wildcard&lt;br&gt;Binds the created script name" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="130.00" width="1200.00" height="130.00" as="geometry" /></mxCell><mxCell id="n7" value="Optional Workers script / same creation flag&lt;br&gt;GET + HEAD only / fixed OCI_PAR_URL fetch on cache miss&lt;br&gt;Cache API key: origin + pathname; query is ignored&lt;br&gt;Secret binding: explicit upstream URL or selected created PAR" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="425.00" width="1200.00" height="150.00" as="geometry" /></mxCell><mxCell id="n9" value="Optional DNS record + two independent rulesets&lt;br&gt;create_cloudflare_dns_record / cache_ruleset / origin_ruleset=false&lt;br&gt;Proxied CNAME; cache rule defaults to /public/&lt;br&gt;Origin rule changes host + SNI, not authorization or URL path" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="830.00" width="1200.00" height="155.00" as="geometry" /></mxCell><mxCell id="n10" value="Optional private Standard bucket / create_asset_bucket=false&lt;br&gt;Versioning Enabled / object events enabled&lt;br&gt;Namespace read is unconditional, even with creation disabled" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n5"><mxGeometry x="657.50" y="457.50" width="85.00" height="85.00" as="geometry" /></mxCell><mxCell id="n11" value="" style="vsdxID=192;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="0.00" y="0.00" width="82.30" height="83.65" as="geometry" /></mxCell><mxCell id="n12" value="" style="vsdxID=193;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="0.00" y="0.00" width="85.00" height="85.00" as="geometry" /></mxCell><mxCell id="n13" value="" style="vsdxID=195;fillColor=#2d5967;gradientColor=none;shape=stencil(tZPJDoMgEIafhiuBoVY9W/seJmIhpWJQu7x9oaSpS0rx0Nsw8/2zkUGs6EXVcQSkH4w+85usB4HYAQHIVnAjB2shViJWNNrwk9FjW/t3VznSWRd9dRnuXrfPcJo4FZCH91CKIX95jl6gZDsRZCme87sc0wC/LmAzkICA2fqbBBS2dbQu8GPkzTv6h2D+bQuafE8N0SSZgUl8TkoC7HKuEPsOxvQQv4EQaY3PZTRSKX9Y0/jykqzLXyErnw==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="40.48" y="18.89" width="28.33" height="24.29" as="geometry" /></mxCell><mxCell id="n14" value="" style="vsdxID=196;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="28.33" y="48.57" width="24.29" height="24.29" as="geometry" /></mxCell><mxCell id="n15" value="" style="vsdxID=197;fillColor=#2d5967;gradientColor=none;shape=stencil(lZJNDoMgEIVPw5bAQCuurb2HiVhILRikf7cvlDTVJlXZPWa+N5kJD7FqVM0gEZDRO3uWd916hdgBAWijpNM+KMRqxKrOOnly9mra9B6aSEZ1sbc44ZF8vMR7Hl1AnqkCHNPyXTkmQ6/NxCAoLnYzgyjwAk8Fhhw+e6ENhrWTyf/pZAZSsoB+mpvgrCVW4CC+39vpvk/pmPZ/4xBKKUqsfgE=);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="13.49" y="18.89" width="26.98" height="24.29" as="geometry" /></mxCell><mxCell id="n16" value="" style="vsdxID=198;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="1.35" y="9.44" width="80.95" height="72.86" as="geometry" /></mxCell><mxCell id="n17" value="" style="vsdxID=199;fillColor=#2d5967;gradientColor=none;shape=stencil(nZLbDoIwDEC/Zq9ktILwjPAfRIYsIiMDFP9eli5hw1v0re1Ol5O2DLOhKXvBgA+jVmdxk9XYMDwwANk1QstxiRjmDLNaaXHSauoqyvvSkCa6qKv5Yaa+kHPTA/zu5wXBrewc+G80SoIYXfg4abIIfdymsA+ilEoz2JIlwGuYkdJdAJEF0AVeuqWxJ8c/iaWJb8Z9q3V88GyOWwbfTMPX+2klX+AlWDdfy7alw3Hft5eylOjKMH8A);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n10" connectable="0"><mxGeometry x="1.35" y="1.35" width="80.95" height="5.40" as="geometry" /></mxCell><mxCell id="n18" value="Optional objects + lifecycle policy&lt;br&gt;create_sample_objects=false / sample map + four defaults&lt;br&gt;create_lifecycle_policy=false AND nonempty rules&lt;br&gt;Selected bucket: created bucket or supplied existing name" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="130.00" width="1200.00" height="130.00" as="geometry" /></mxCell><mxCell id="n20" value="Optional preauthenticated requests / preauth_requests={}&lt;br&gt;Access type, scope, object and expiry are supplied&lt;br&gt;A PAR is authorization material, not a forwarding service&lt;br&gt;No public bucket access is enabled" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="830.00" width="1200.00" height="155.00" as="geometry" /></mxCell><mxCell id="n23" value="OCI DNS CNAME / create_dns_cname=false: existing zone + explicit target hostname.&lt;br&gt;IAM policy / statements=[]: home provider, policy compartment falls back to tenancy.&lt;br&gt;Cloudflare zone/account, KMS key and DNS zones are references, not created resources.&lt;br&gt;Origin rules alone cannot read a private bucket. PAR broker sample is not deployed." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="660.00" width="1200.00" height="130.00" as="geometry" /></mxCell><mxCell id="n24" value="Worker caches successful responses; TTL default 300 s.&lt;br&gt;No path append to the fixed upstream URL. Review query-insensitive&lt;br&gt;cache keys and PAR scope before using personalized content.&lt;br&gt;DNS, cache and origin rules can be enabled independently." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="650.00" width="1200.00" height="130.00" as="geometry" /></mxCell><mxCell id="n25" value="DEFAULT RESULT: No created cloud resources; all create flags false, maps and IAM statements empty. The namespace data lookup still runs.&lt;br&gt;Six OCI and five Cloudflare resource declarations are enumerated in native detail pages. DNS records do not automatically bind each other.&lt;br&gt;The explicit Worker-to-bucket arrow is configured fetch intent, not a claim of successful authorization, origin connectivity or cache delivery.&lt;br&gt;No private-origin request, browser cache, cache isolation, DNS cutover, credential expiry or cross-cloud traffic was tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1360.00" width="2940.00" height="160.00" as="geometry" /></mxCell><mxCell id="n26" value="Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged.&lt;br&gt;No provisioning, image build/pull, invocation, event delivery, application traffic or cloud test was run." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1570.00" width="2940.00" height="60.00" as="geometry" /></mxCell><mxCell id="n8" value="script_name association / matched requests use script" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n19" value="namespace / selected bucket / explicit object names" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n21" value="PAR grant scope: bucket / optional object" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2940" y="1067.5" /><mxPoint x="2940" y="660" /></Array><mxPoint x="-100" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="n22" value="Cache miss: fetch fixed OCI_PAR_URL / only when configured" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relati