e=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="50.00" y="780.00" width="1320.00" height="155.00" as="geometry" /></mxCell><mxCell id="n67" value="Cluster/node creation is independently optional. Existing VCN/subnet/cluster IDs can be selected.&lt;br&gt;No DRG, FastConnect, peering, VPN or remote-prefix route is declared by this entry point.&lt;br&gt;Default contracts have null endpoint/circuit/secondary IDs; source defaults are not a complete failover configuration." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="50.00" y="970.00" width="1320.00" height="110.00" as="geometry" /></mxCell><mxCell id="n68" value="AWS standby / separately deployed CloudFormation / selected region" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1540.00" y="160.00" width="1420.00" height="1120.00" as="geometry" /></mxCell><mxCell id="n69" value="VPC / 10.64.0.0/16" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n68"><mxGeometry x="50.00" y="80.00" width="1320.00" height="600.00" as="geometry" /></mxCell><mxCell id="n70" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=ce