ol-plane log types enabled; VPC flow-log destination is a separate explicitly declared Log Group." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n69"><mxGeometry x="35.00" y="535.00" width="1250.00" height="60.00" as="geometry" /></mxCell><mxCell id="n94" value="KMS key / rotation on" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n68"><mxGeometry x="145.00" y="825.00" width="50.00" height="50.00" as="geometry" /></mxCell><mxCell id="n95" value="" style="shape=mxgraph.aws4.key_management_service;fillColor=#DD344C;strokeColor=none;" vertex="1" parent="n94" connectable="0"><mxGeometry x="0.00" y="0.00" width="50.00" height="50.00" as="geometry" /></mxCell><mxCell id="n96" value="VPC flow-log group / 30 days" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n68"><mxGeometry x="625.00" y="825.00" width="50.00" height="50.00" as="geometry" /></mxCell><mxCell id="n97" value="" style="shape=mxgraph.aws4.cloudwatch_logs;fillColor=#E7157B;strokeColor=none;" vertex="1" parent="n96" connectable="0"><mxGeometry x="0.00" y="0.00" width="50.00" height="50.00" as="geometry" /></mxCell><mxCell id="n98" value="VPC Flow Log / ALL" style="html=1;fillColor=none;strokeColor=none;conta