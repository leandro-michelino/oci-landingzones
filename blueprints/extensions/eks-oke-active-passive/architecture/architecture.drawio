xGLyt2WtjsrOn759WjqX8DaB5AA==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n113" connectable="0"><mxGeometry x="17.14" y="20.00" width="8.57" height="8.57" as="geometry" /></mxCell><mxCell id="n121" value="" style="vsdxID=111;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n113" connectable="0"><mxGeometry x="12.86" y="17.14" width="15.71" height="15.71" as="geometry" /></mxCell><mxCell id="n122" value="Existing application targets / both endpoint inputs null&lt;br&gt;OCI primary + AWS standby; applications/ingress remain external&lt;br&gt;These are application answers, not Kubernetes API endpoints" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n106"><mxGeometry x="1920.00" y="150.00" width="960.00" height="125.00" as="geometry" /></mxCell><mxCell id="n128" value="DNS policy returns an answer; it does not forward application packets or replicate data. Health checks require reachable targets. No active-active weights are implemented.&lt;br&gt;The default GitOps/steering contracts store metadata only. Optional real DNS resources do not install applications, data synchronization or failover runbooks." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n106"><mxGeometry x="40.00" y="380.00" width="2840.00" height="45.00" as="geometry" /></mxCell><mxCell id="n129" value="SOURCE DEFAULTS ARE INCOMPLETE: OCI network enabled, OKE/node flags false, real Traffic Management false; circuit/secondary/application IDs null.&lt;br&gt;IPSec backup is explicitly forbidden by this pattern. Companion Azure/AWS templates deploy separately and do not establish the intercloud path.&lt;br&gt;No workloads, GitOps controller, cluster autoscaling, application LB, data replication or working recovery path is delivered by the OCI contracts.&lt;br&gt;All conditional OCI/cloud declarations and metadata contracts are enumerated in native companion pages; no provisioning or failover was tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1840.00" width="2940.00" height="140.00" as="geometry" /></mxCell><mxCell id="n130" value="Source / rendered-diagram review: 2026-10-28. Historical Terraform/provider and earlier live-test evidence remain unchanged. No cloud operations were run in this diagram batch." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="2020.00" width="2940.00" height="45.00" as="geometry" /></mxCell><mxCell id="n24" value="Selected cluster_id / optional" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n28" value="Service-LB subnet option" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;e