p;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1320.00" y="160.00" width="1160.00" height="900.00" as="geometry" /></mxCell><mxCell id="n52" value="Custom regional VPC / no Internet default route" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n51"><mxGeometry x="30.00" y="80.00" width="1100.00" height="660.00" as="geometry" /></mxCell><mxCell id="n53" value="VPC" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=4;" vertex="1" parent="n52"><mxGeometry x="69.00" y="69.00" width="52.00" height="52.00" as="geometry" /></mxCell><mxCell id="n54" value="" style="shape=mxgraph.gcp2.cloud_network;fillColor=#4285F4;strokeColor=none;" vertex="1" parent="n53" connectable="0"><mxGeometry x="0.00" y="0.00" width="52.00" height="52.00" as="geometry" /></mxCell><mxCell id="n55" value="Workload subnet / 10.96.10.0/24" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n52"><mxGeometry x="45.00" y="180.00" width="1000.00" height="175.00" as="geometry" /></mxCell><mxCell id="n56" value="No workload is created. VMs must carry interconnect-client tag.&lt;br&gt;Scoped ingress + egress allow rules; tagged clients have explicit deny egress." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n55"><mxGeometry x="25.00" y="75.00" width="950.00" height="80.00" as="geometry" /></mxCell><mxCell id="n57" value="Cloud Router / ASN 16550" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n52"><mxGeometry x="772.50" y="452.50" width="55.00" height="55.00" as="geometry" /></mxCell><mxCell id="n58" value="" style="shape=mxgraph.gcp2.cloud_router;fillColor=#4285F4;strokeColor=none;" vertex="1" parent="n57" connectable="0"><mxGeometry x="0.00" y="0.00" width="55.00" height="55.00" as="geometry" /></mxCell><mxCell id="n59" value="Custom advertisement: remote subnet only&lt;br&gt;Two router interfaces + peers / OCI ASN 31898&lt;br&gt;BGP configuration gated by enable_bgp=false" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n52"><mxGeometry x="400.00" y="545.00" width="650.00" height="80.00" as="geometry" /></mxCell><mxCell id="n60" value="2 Partner VLAN attachments&lt;br&gt;Edge domains 1 + 2 / MTU 1500" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n52"><mxGeometry x="120.00" y="450.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n61" value="" style="shape=mxgraph.gcp2.partner_interconnect;fillColor=#4285F4;strokeColor=none;" vertex="1" parent="n60" connectable="0"><mxGeometry x="0.00" y="0.00" width="60.00" height="60.00" as="geometry" /></mxCell><mxCell id="n63" value="Google attachments emit pairing keys. OCI creates one private VC per key.&lt;br&gt;Approved BGP address pairs are explicit inputs; partner provisioning and&lt;br&gt;attachment activation must precede operational BGP verification." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n51"><mxGeometry x="35.00" y="780.00" width="1090.00" height="85.00" as="geometry" /></mxCell><mxCell id="n66" value="DISABLED DEFAULTS: enable_foundation=false / enable_interconnect=false / costs_approved=false / region_pair_verified=false / application TCP port set empty.&lt;br&gt;Foundation creates two Google Partner attachments; activate_attachments=false. enable_bgp=false; enabling circuits requires two approved BGP address pairs.&lt;br&gt;Partner bandwidth is selected through OCI; no guessed Google PARTNER bandwidth, VLAN or physical cross-connect is created. Private transport does not imply encryption.&lt;br&gt;All source-declared resources and operator-supplied identifiers appear on companion detail pages. No live provisioning, packet flow or failover was tested." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n67" value="Local review 2026-10-28: schema validation and mocked plans only; no provisioning, BGP, packet flow or resilience test.&lt;br&gt;Source CIDRs are examples; regions, provider offerings and BGP addresses require operator verification." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1340.00" width="2460.00" height="55.00" as="geometry" /></mxCell><mxCell id="n49" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n42"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n62" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n60" target="n57"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n64" value="2 private VCs / Partner Interconnect" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;startArrow=open;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n42" target="n60"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="720" /><mxPoint x="1260" y="720" /><mxPoint x="1260" y="720" /></Array><mxPoint x="0" y="23.0" as="offset" /></mxGeometry></mxCell><mxCell id="n65" value="" style="shape=image;aspect=fixed;image=data:image/svg+xml,;;labelBackgroundColor=#FFFFFF;fillColor=#FFFFFF;" vertex="1" connectable="0" parent="n64"><mxGeometry x="0" y="0" width="37.3" height="26.0" relative="1" as="geometry"><mxPoint x="-18.6" y="-13.0" as="offset" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="Contracts resources"><mxGraphModel dx="2580" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Contracts resources | gcp-oci-partner-interconnect" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Contracts / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="290.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="60.00" width="820.00" height="195.00" as="geometry" /></mxCell><mxCell id="n5" value="terraform_data.guard&lt;br&gt;terraform_data&lt;br&gt;Unconditional declaration; module-level gates/inputs may still apply." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="20.00" y="20.00" width="780.00" height="155.00" as="geometry" /></mxCell><mxCell id="n6" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="GCP resources"><mxGraphModel dx="2580" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="1070" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="GCP resources | gcp-oci-partner-interconnect" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=mid