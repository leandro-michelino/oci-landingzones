/></mxCell><mxCell id="n58" value="" style="vsdxID=302;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n54" connectable="0"><mxGeometry x="17.95" y="20.71" width="20.71" height="11.05" as="geometry"/></mxCell><mxCell id="n59" value="Service gateway access is distinct&lt;br&gt;from a service private endpoint." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n53"><mxGeometry x="15.00" y="160.00" width="250.00" height="45.00" as="geometry"/></mxCell><mxCell id="n61" value="PRIVATE DEFAULT&lt;br&gt;No Internet Gateway&lt;br&gt;NAT disabled&lt;br&gt;No public ingress" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="320.00" width="180.00" height="145.00" as="geometry"/></mxCell><mxCell id="n62" value="OPTIONAL / NAT&lt;br&gt;Disabled by default. Enabling NAT creates the gateway only; add the matching route explicitly.&lt;br&gt;This blueprint creates no service-specific private endpoints, NSGs or workloads." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="875.00" width="1700.00" height="95.00" as="geometry"/></mxCell><mxCell id="n63" value="Baseline egress: VCN CIDR + TCP 443 to regional OSN. Subnet badges denote associated route tables and security lists.&lt;br&gt;Lines show configured routing / associations, not verified packet flows. Review: 2026-10-28; no new OCI apply or runtime validation.&lt;br&gt;Sources: blueprint main.tf, variables.tf and the referenced spoke-vcn module. CIDRs are defaults, not a discovered live network." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="995.00" width="1700.00" height="70.00" as="geometry"/></mxCell><mxCell id="n41" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="387.5"/><mxPoint x="1010" y="590"/></Array></mxGeometry></mxCell><mxCell id="n42" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="537.5"/><mxPoint x="1010" y="590"/></Array></mxGeometry></mxCell><mxCell id="n43" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="687.5"/><mxPoint x="1010" y="590"/></Array></mxGeometry></mxCell><mxCell id=