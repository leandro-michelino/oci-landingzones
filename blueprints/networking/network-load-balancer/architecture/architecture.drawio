ght="1.00" as="geometry" /></mxCell><mxCell id="n19" value="" style="vsdxID=104;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n13" connectable="0"><mxGeometry x="2.00" y="31.00" width="17.00" height="5.00" as="geometry" /></mxCell><mxCell id="n20" value="" style="vsdxID=105;fillColor=#2d5967;gradientColor=none;shape=stencil(lZFNDoMgEIVPw5bggIWurb2HiVhIKRikf7cvlDRVG23cvRm+eTPhIVoNquklAjIE787yrtugED0gAG2V9DpEhWiNaNU5L0/eXW2b675JZFIXd0sOjzxXEJJmgDw/NYZ345hpo+2IFntcwoQny/DUWHDMy2U47mVidsmKNysw32L/ezgDLHZr92z5l390FN8AOm1Mzm/8Pg8stnLYtH4B);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n13" connectable="0"><mxGeometry x="36.00" y="33.00" width="4.00" height="4.00" as="geometry" /></mxCell><mxCell id="n21" value="" style="vsdxID=106;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n13" connectable="0"><mxGeometry x="2.00" y="0.00" width="37.00" height="37.00" as="geometry" /></mxCell><mxCell id="n22" value="oci_identity_policy.access&lt;br&gt;oci_identity_policy&lt;br&gt;count = length(var.policy_statements) &amp;gt; 0 ? 1 : 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n12"><mxGeometry x="100.00" y="20.00" width="700.00" height="155.00" as="geometry" /></mxCell><mxCell id="n23" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="680.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="Existing resources / inputs"><mxGraphModel dx="2560" dy="755" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2600" pageHeight="795" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Existing resources and overrides | network-load-balancer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Source-declared identifier inputs / not created resources / no live inventory or private tfvars read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n4" value="var.compartment_ocid&lt;br&gt;Compartment OCID where resources are created. Defaults to tenancy_ocid for&lt;br&gt;validation-only tests.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n5" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n6" value="var.network_load_balancer_id&lt;br&gt;Existing Network Load Balancer OCID when create_network_load_balancer is false.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n7" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1720.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n8" value="var.subnet_id&lt;br&gt;Subnet OCID for Network Load Balancer placement.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n7"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n9" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="370.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n10" value="var.network_security_group_ids&lt;br&gt;NSG OCIDs attached to the Network Load Balancer.&lt;br&gt;Default expression: []" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n11" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="370.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n12" value="var.policy_compartment_ocid&lt;br&gt;Compartment OCID where the optional IAM policy is created. Defaults to tenancy_ocid.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n11"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n13" value="These inputs identify separately managed resources or override a default selection. The overview and module call-site decide their use.&lt;br&gt;Null/empty defaults do not prove that an external resource exists. Input names and defaults are source contracts, not discovered cloud inventory.&lt;br&gt;Collection inputs can contain further resource references; consult their source schemas and the overview prerequisites. No ownership adoption is implied." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="625.00" width="2540.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
