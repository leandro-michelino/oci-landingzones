<mxfile host="ocidraw" type="device"><diagram id="oci" name="OCI Network Load Balancer | Create or extend"><mxGraphModel dx="2460" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2500" pageHeight="1350" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI Network Load Balancer | Create or extend" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2360.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="NETWORKING 23 / Official OCI Toolkit v24.2 / Source-defined resources and explicit prerequisites" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2360.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="OCI / region input" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F4F2;rounded=1;arcSize=2;absoluteArcSize=0;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;spacingLeft=6;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="160.00" width="1680.00" height="850.00" as="geometry" /></mxCell><mxCell id="n4" value="Target compartment / operator input" style="whiteSpace=wrap;html=1;dashed=1;dashPattern=1 1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="50.00" width="1640.00" height="770.00" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;Existing VCN / supplied separately&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#312D2A&quot;&gt;CIDR TBC; no VCN created by this blueprint&lt;/font&gt;" style="whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;spacingTop=2;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="30.00" y="100.00" width="1580.00" height="560.00" as="geometry" /></mxCell><mxCell id="n6" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;dashed=1;dashPattern=1 1;strokeColor=#bb511c;strokeWidth=3;fontColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n5"><mxGeometry x="1540.57" y="-15.00" width="31.43" height="30.00" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;Existing subnet / subnet_id input&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#312D2A&quot;&gt;CIDR TBC&lt;/font&gt;" style="whiteSpace=wrap;html=1;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="30.00" y="100.00" width="680.00" height="350.00" as="geometry" /></mxCell><mxCell id="n8" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontColor=#312D2A;strokeColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n7"><mxGeometry x="648.00" y="-12.00" width="24.00" height="24.00" as="geometry" /></mxCell><mxCell id="n9" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;dashed=1;dashPattern=1 1;strokeColor=#bb511c;strokeWidth=3;fontColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n7"><mxGeometry x="627.71" y="-12.00" width="18.29" height="24.00" as="geometry" /></mxCell><mxCell id="n10" value="Conditional create / or reuse existing NLB" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalAlign=top;spacingTop=12;" vertex="1" parent="n7"><mxGeometry x="25.00" y="70.00" width="630.00" height="240.00" as="geometry" /></mxCell><mxCell id="n11" value="Network Load Balancer (Layer 4)&lt;br&gt;Create flag=false; existing ID=null by default&lt;br&gt;When created: private=true; IP version IPV4&lt;br&gt;Source/destination preservation=false; symmetric hash=false" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n10"><mxGeometry x="25.00" y="65.00" width="580.00" height="135.00" as="geometry" /></mxCell><mxCell id="n12" value="Listeners and backend sets&lt;br&gt;Both maps empty by default&lt;br&gt;Policy / health checker / protocol / ports from inputs" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="850.00" y="110.00" width="650.00" height="150.00" as="geometry" /></mxCell><mxCell id="n14" value="The existing network, subnet routes and security controls are supplied separately.&lt;br&gt;This blueprint configures the NLB and optional access policy; it does not create workload targets." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="50.00" y="700.00" width="1450.00" height="45.00" as="geometry" /></mxCell><mxCell id="n15" value="Backend targets / operator-supplied ownership and placement" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1760.00" y="160.00" width="700.00" height="470.00" as="geometry" /></mxCell><mxCell id="n16" value="Configured IP addresses or target IDs&lt;br&gt;No backend VMs are created.&lt;br&gt;Targets need not be in the NLB subnet.&lt;br&gt;Health, network reachability and security remain to be verified." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n15"><mxGeometry x="25.00" y="100.00" width="650.00" height="180.00" as="geometry" /></mxCell><mxCell id="n18" value="IAM / no policy by default" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalAlign=top;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="1760.00" y="720.00" width="700.00" height="290.00" as="geometry" /></mxCell><mxCell id="n19" value="policy_statements=[]&lt;br&gt;When provided, IAM policy targets tenancy root by default&lt;br&gt;or an explicit policy compartment, through the home-region provider.&lt;br&gt;This scope is separate from the network compartment." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n18"><mxGeometry x="25.00" y="75.00" width="650.00" height="140.00" as="geometry" /></mxCell><mxCell id="n20" value="DEFAULT RESULT / NO RESOURCE CREATION&lt;br&gt;create_network_load_balancer=false, existing NLB ID=null, backend_sets={}, listeners={}, policy_statements=[].&lt;br&gt;To create, supply a subnet and enable creation. To extend, supply an existing NLB ID and the desired configuration maps.&lt;br&gt;Dashed arrows show configuration relationships; there is no operational listener or backend path under the defaults." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1090.00" width="2360.00" height="120.00" as="geometry" /></mxCell><mxCell id="n21" value="Source defaults and operator inputs, not discovered live inventory. Arrows show configuration / intended routing, not verified traffic.&lt;br&gt;Review: 2026-10-28. No new provisioning, provider validation, workload connectivity, isolation or failover test." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1245.00" width="2360.00" height="65.00" as="geometry" /></mxCell><mxCell id="n13" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="825" y="540" /><mxPoint x="825" y="545" /></Array></mxGeometry></mxCell><mxCell id="n17" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1730" y="545" /><mxPoint x="1730" y="395" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="850" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | network-load-balancer" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Complete declaration map / paired with architecture.png for topology / Source review 2026-10-28" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="OCI / source-declared resources; conditional declarations remain visible" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;dashed=1;align=center;verticalAlign=top;fillColor=none;strokeColor=#312D2A;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="135.00" width="2560.00" height="510.00" as="geometry" /></mxCell><mxCell id="n4" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColo