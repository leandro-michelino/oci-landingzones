# Maintainer: Leandro Michelino | ACE | leandro.michelino@oracle.com
tenancy_ocid       = "ocid1.tenancy.oc1..example"
current_user_ocid  = "ocid1.user.oc1..example"
region             = "eu-madrid-1"
home_region        = "eu-madrid-1"
oci_config_profile = "DEFAULT"

org         = "acme"
environment = "prod"
region_key  = "mad"

# This blueprint variant keeps OCI as primary.
oci_is_primary = true

# OCI primary networking defaults create:
# VCN + route table + security list + primary hub subnet.
enable_oci_primary_network      = true
oci_primary_vcn_cidr            = "10.58.0.0/16"
oci_primary_hub_subnet_cidr     = "10.58.10.0/24"
oci_primary_ingress_allowed_cidr = "10.0.0.0/8"

# Choose connectivity mode: without-interconnect (IPSec first) or interconnect.
connectivity_mode = "without-interconnect"
# fastconnect_virtual_circuit_id = null
# expressroute_circuit_id        = null

# Azure vWAN and vHub metadata for transit contracts.
# azure_virtual_wan_id           = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualWans/<name>"
# azure_virtual_hub_id           = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualHubs/<name>"
azure_virtual_hub_region         = "westeurope"
azure_virtual_hub_address_prefix = "10.89.255.0/24"
azure_route_table_name           = "rt-vhub-oci-transit"
enable_route_segmentation        = true

transit_segments = {
  prod       = ["10.88.10.0/24"]
  nonprod    = ["10.88.20.0/24"]
  management = ["10.88.30.0/24"]
}

# Fallback IPSec + BGP profile.
enable_ipsec_fallback = true
# azure_cpe_public_ip = "203.0.113.10"
azure_bgp_asn       = 65515
azure_network_cidrs = ["10.88.0.0/16"]
bgp_keepalive_seconds = 20
bgp_hold_seconds      = 60

# Optional transit operations topic.
enable_transit_alert_topic = true
# transit_alert_topic_name = "acme-prod-mad-top-azure-vwan-transit"

# DNS and health probe contract.
enable_dns_contract         = true
private_dns_zone_fqdn       = "corp.internal"
# oci_dns_resolver_endpoint   = "10.58.10.10"
# azure_dns_resolver_endpoint = "10.88.1.4"
health_probe_fqdn           = "transit-probe.example.internal"
target_convergence_seconds  = 120

defined_tags = {
  "acme-tags.Environment" = "prod"
  "acme-tags.ManagedBy"   = "terraform"
  "acme-tags.Owner"       = "platform-team"
  "acme-tags.Project"     = "landingzone"
}

freeform_tags = {
  Blueprint = "azure-vwan-oci-drg-transit"
}
