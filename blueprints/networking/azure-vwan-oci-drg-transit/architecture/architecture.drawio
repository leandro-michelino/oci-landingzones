alue="CONTRACT LIMITS / metadata is not enforcement&lt;br&gt;Default mode: without-interconnect. Interconnect mode needs existing FastConnect, ExpressRoute, vWAN and vHub IDs.&lt;br&gt;Segmentation maps, BGP timers, DNS and 120-second convergence target are contracts; they do not deploy segmentation or a failover controller.&lt;br&gt;The Azure VPN endpoint is in the workload VNet; the template does not declare a vHub VPN gateway. Validate actual transit and static OCI IPSec routes separately." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1300.00" width="2360.00" height="120.00" as="geometry"/></mxCell><mxCell id="n102" value="Source defaults and operator inputs, not discovered live inventory. Arrows show configuration / intended routing, not verified traffic.&lt;br&gt;Review: 2026-10-28. No new provisioning, provider validation, workload connectivity, isolation or failover test." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1455.00" width="2360.00" height="65.00" as="geometry"/></mxCell><mxCell id="n8" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent