gnMqnBLenDxneZEOlGip09u4pRQ/aG/gTPhFf0Gf8J/otGcdXRkjHc5n3/rC+OuHosDw==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n82" connectable="0"><mxGeometry x="22.86" y="13.71" width="1.14" height="1.14" as="geometry" /></mxCell><mxCell id="n110" value="" style="vsdxID=184;fillColor=#2d5967;gradientColor=none;shape=stencil(nZJBDsIgEEVPM1tCGTTsa71Hk1IhIjQUq95eEBsbF5a6+zPzhnzgA9ajagcJjI7Bu7O86S4owAMwpq2SXoeoABvAundenry72i7XQ5vIpC5uSifc817FidinLUYf7w6lr/qYcaPtAhc7UvFyfB7OMKcERTkezXFWjv8w8ie4YmDb5ba99CoexedTe21MzsRy/h2C2MoBwuYJ);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n82" connectable="0"><mxGeometry x="21.71" y="17.14" width="3.43" height="11.43" as="geometry" /></mxCell><mxCell id="n111" value="" style="vsdxID=185;fillColor=#2d5967;gradientColor=none;shape=stencil(nZBLCoAwDERPk31tjuDnHoLVBmsrtf5ub0sQRdzobiZ5ycAA5pOuRwVSTMG7Xq3UBA1YgJRktfIUogIsAfPWedV5N9uG/VgnMqnBLenDxneZEOlGip09u4pRQ/aG/gTPhFf0Gf8J/otGcdXRkjHc5n3/rC+OuHosDw==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n82" connectable="0"><mxGeometry x="21.71" y="30.86" width="3.43" height="3.43" as="geometry" /></mxCell><mxCell id="n112" value="VPN flag defaults true; Azure CPE IP is null → incomplete full-default inputs.&lt;br&gt;No NAT / SGW. Network creation can be disabled; DRG can be reused." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n24"><mxGeometry x="60.00" y="815.00" width="780.00" height="65.00" as="geometry" /></mxCell><mxCell id="n113" value="CONTRACT LIMITS / metadata is not enforcement&lt;br&gt;Default mode: without-interconnect. Interconnect mode needs existing FastConnect, ExpressRoute, vWAN and vHub IDs.&lt;br&gt;Segmentation maps, BGP timers, DNS and 120-second convergence target are contracts; they do not deploy segmentation or a failover controller.&lt;br&gt;The Azure VPN endpoint is in the workload VNet; the template does not declare a vHub VPN gateway. Validate actual transit and static OCI IPSec routes separately." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1300.00" width="2360.00" height="120.00" as="geometry" /></mxCell><mxCell id="n114" value="Source defaults and operator inputs, not discovered live inventory. Arrows show configuration / intended routing, not verified traffic.&lt;br&gt;Review: 2026-10-28. No new provisioning, provider validation, workload connectivity, isolation or failover test." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1455.00" width="2360.00" height="65.00" as="geometry" /></mxCell><mxCell id="n20" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n21" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" 