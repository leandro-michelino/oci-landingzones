# Maintainer: Leandro Michelino | ACE | leandro.michelino@oracle.com
tenancy_ocid       = "ocid1.tenancy.oc1..example"
current_user_ocid  = "ocid1.user.oc1..example"
region             = "eu-madrid-1"
home_region        = "eu-madrid-1"
oci_config_profile = "DEFAULT"

org         = "acme"
environment = "prod"
region_key  = "mad"

# This blueprint variant keeps OCI as primary.
oci_is_primary = true

# OCI primary networking defaults are deploy-and-use and create:
# VCN + route table + security list + primary hub subnet.
enable_oci_primary_network    = true
oci_primary_vcn_cidr          = "10.58.0.0/16"
oci_primary_hub_subnet_cidr   = "10.58.10.0/24"
oci_primary_ingress_allowed_cidr = "10.0.0.0/8"

# Choose connectivity mode: interconnect or without-interconnect.
connectivity_mode = "interconnect"
# fastconnect_virtual_circuit_id = "ocid1.virtualcircuit.oc1..example"
# expressroute_circuit_id        = "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.Network/expressRouteCircuits/<name>"

# Fallback IPSec + BGP profile.
enable_ipsec_fallback = true
# azure_cpe_public_ip = "203.0.113.10"
azure_bgp_asn       = 65515
azure_network_cidrs = ["10.88.0.0/16"]
bgp_keepalive_seconds = 20
bgp_hold_seconds      = 60

# Optional connectivity operations topic.
enable_connectivity_alert_topic = true
# connectivity_alert_topic_name = "acme-prod-mad-top-azure-connectivity"

# DNS and health probe contract.
enable_dns_contract         = true
private_dns_zone_fqdn       = "corp.internal"
# oci_dns_resolver_endpoint   = "10.58.10.10"
# azure_dns_resolver_endpoint = "10.88.1.4"
health_probe_fqdn           = "connectivity-probe.example.internal"
target_failover_seconds     = 120

defined_tags = {
  "acme-tags.Environment" = "prod"
  "acme-tags.ManagedBy"   = "terraform"
  "acme-tags.Owner"       = "platform-team"
  "acme-tags.Project"     = "landingzone"
}

freeform_tags = {
  Blueprint = "azure-oci-dual-connectivity"
}
