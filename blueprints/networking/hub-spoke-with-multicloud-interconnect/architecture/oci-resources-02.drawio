ot inferred beyond source.&lt;br&gt;Read-only data lookups (not created resources): module.network.module.hub_vcn.oci_core_services.all_services, module.network.module.spoke_vcns.oci_core_services.all_services" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
