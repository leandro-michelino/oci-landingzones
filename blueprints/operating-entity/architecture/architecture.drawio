;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="500.00" width="2360.00" height="590.00" as="geometry"/></mxCell><mxCell id="n27" value="Operating entity / default code entity / created root compartment" style="whiteSpace=wrap;html=1;dashed=1;dashPattern=1 1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n26"><mxGeometry x="30.00" y="80.00" width="2300.00" height="430.00" as="geometry"/></mxCell><mxCell id="n28" value="platform / created child" style="whiteSpace=wrap;html=1;dashed=1;dashPattern=1 1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n27"><mxGeometry x="25.00" y="100.00" width="733.33" height="200.00" as="geometry"/></mxCell><mxCell id="n29" value="workloads / created child" style="whiteSpace=wrap;html=1;dashed=1;dashPattern=1 1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n27"><mxGeometry x="778.33" y="100.00" width="733.33" height="200.00" as="geometry"/></mxCell><mxCell id="n30" value="security / created child" style="whiteSpace=wrap;html=1;dashed=1;dashPattern=1 1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n27"><mxGeometry x="1531.67" y="100.00" width="733.33" height="200.00" as="geometry"/></mxCell><mxCell id="n31" value="Child map can be overridden. Root + child compartment paths feed delegated policies." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n27"><mxGeometry x="25.00" y="345.00" width="2250.00" height="45.00" as="geometry"/></mxCell><mxCell id="n33" value="DEFAULT SHAPE: 1 root + 3 children; 2 IAM groups and 2 policies.&lt;br&gt;Administrators manage all-resources; auditors read all-resources in the generated entity root and child paths.&lt;br&gt;No VCN, compute, database, users or membership assignments are created. enable_delete defaults true for the generated compartment package." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1170.00" width="2360.00" height="130.00" as="geometry"/></mxCell><mxCell id="n34" value="Arrows show configuration dependencies / IAM bindings, not application traffic or proven isolation.&lt;br&gt;Source review: 2026-10-28. No cloud provisioning, provider revalidation, login/permission test or compliance certification.&lt;br&gt;Regions, parent compartments and names are supplied or derived from inputs. Historical validation metadata is unchanged." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1335.00" width="2360.00" height="80.00" as="geometry"/></mxCell><mxCell id="n32" value="Scoped policy statements / no workload deployment" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
