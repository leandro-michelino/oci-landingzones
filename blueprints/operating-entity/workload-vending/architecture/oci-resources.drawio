metry x="2.00" y="0.00" width="37.00" height="37.00" as="geometry"/></mxCell><mxCell id="n47" value="module.policies.oci_identity_policy.this&lt;br&gt;oci_identity_policy&lt;br&gt;for_each = local.policies" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n37"><mxGeometry x="100.00" y="20.00" width="700.00" height="155.00" as="geometry"/></mxCell><mxCell id="n48" value="Counts are declarations, not deployed instances. for_each and Bicep collections expand from inputs; gates retain their source expressions.&lt;br&gt;Pinned-module declarations use the module call-site inputs; the overview explains default enablement. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="680.00" width="2560.00" height="130.00" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
