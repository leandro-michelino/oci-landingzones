il();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n21" connectable="0"><mxGeometry x="35.00" y="25.00" width="31.67" height="8.33" as="geometry" /></mxCell><mxCell id="n29" value="Inference endpoint / create=false" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n4"><mxGeometry x="2065.00" y="227.50" width="70.00" height="65.00" as="geometry" /></mxCell><mxCell id="n30" value="" style="vsdxID=261;fillColor=#FFFFFF;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="0.00" y="0.00" width="70.00" height="65.00" as="geometry" /></mxCell><mxCell id="n31" value="" style="vsdxID=263;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="35.00" y="0.00" width="10.00" height="11.67" as="geometry" /></mxCell><mxCell id="n32" value="" style="vsdxID=264;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="35.00" y="48.33" width="10.00" height="11.67" as="geometry" /></mxCell><mxCell id="n33" value="" style="vsdxID=265;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="1.67" y="0.00" width="31.67" height="61.67" as="geometry" /></mxCell><mxCell id="n34" value="" style="vsdxID=266;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="35.00" y="8.33" width="26.67" height="13.33" as="geometry" /></mxCell><mxCell id="n35" value="" style="vsdxID=267;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="35.00" y="36.67" width="26.67" height="13.33" as="geometry" /></mxCell><mxCell id="n36" value="" style="vsdxID=268;fillColor=#2c5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n29" connectable="0"><mxGeometry x="35.00" y="25.00" width="31.67" height="8.33" as="geometry" /></mxCell><mxCell id="n40" value="Private / Standard / versioned / events&lt;br&gt;Existing KMS key optional&lt;br&gt;No dataset upload or preprocessing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="40.00" y="365.00" width="520.00" height="100.00" as="geometry" /></mxCell><mxCell id="n41" value="One created cluster selects one type.&lt;br&gt;Training config: TFEW_TRAINING_CONFIG&lt;br&gt;Epochs / batch size / learning rate null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="610.00" y="365.00" width="640.00" height="100.00" as="geometry" /></mxCell><mxCell id="n42" value="Base model and cluster IDs can be supplied.&lt;br&gt;Dataset: datasets/training.jsonl&lt;br&gt;Namespace required for existing bucket" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1290.00" y="365.00" width="620.00" height="100.00" as="geometry" /></mxCell><mxCell id="n43" value="Existing compatible base_model_id&lt;br&gt;EXTERNAL model selection / required for tuning" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1090.00" y="570.00" width="560.00" height="95.00" as="geometry" /></mxCell><mxCell id="n44" value="Separate compatible HOSTING cluster ID&lt;br&gt;Required when the created cluster is FINE_TUNING&lt;br&gt;Alternative: create a HOSTING-only cluster, reuse model" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="1790.00" y="570.00" width="610.00" height="120.00" as="geometry" /></mxCell><mxCell id="n47" value="Optional existing generative_ai_private_endpoint_id can attach the inference endpoint.&lt;br&gt;Its null default does not establish private transport; this blueprint creates no private endpoint or subnet.&lt;br&gt;Optional IAM policy uses the home provider; policy compartment defaults to tenancy root." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="50.00" y="785.00" width="2300.00" height="95.00" as="geometry" /></mxCell><mxCell id="n48" value="DEFAULT RESULT: No cloud resources; all creation flags false and policy statements empty.&lt;br&gt;A FINE_TUNING cluster must not be reused for inference hosting. Supplying a HOSTING cluster enables the separate endpoint path.&lt;br&gt;Model creation references the dataset object but does not upload/curate training data. Base model/shape availability, compatibility and training completion were not tested.&lt;br&gt;No inference call, private access, quality evaluation or production readiness is verified by this diagram." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n49" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n37" value="fine_tune_details.dedicated_ai_cluster_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvet