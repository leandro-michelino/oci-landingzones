t. Companion templates deploy separately.&lt;br&gt;Resource cards enumerate coverage only; card order does not imply dependency or traffic. IAM, DNS, circuits and workloads are not inferred beyond source.&lt;br&gt;Read-only data lookups (not created resources): oci_objectstorage_namespace.this" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="460.00" width="2560.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-1" name="Existing resources / inputs"><mxGraphModel dx="2560" dy="755" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2600" pageHeight="795" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Existing resources and overrides | genai-private" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="Source-declared identifier inputs / not created resources / no live inventory or private tfvars read" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2540.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n4" value="var.compartment_ocid&lt;br&gt;Compartment OCID where resources are created. Defaults to tenancy_ocid for&lt;br&gt;validation-only tests.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n3"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n5" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n6" value="var.subnet_id&lt;br&gt;Subnet OCID for the private endpoint.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n7" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1720.00" y="140.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n8" value="var.nsg_ids&lt;br&gt;NSG OCIDs for the private endpoint.&lt;br&gt;Default expression: []" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n7"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n9" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="370.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n10" value="var.kms_key_id&lt;br&gt;Optional KMS key OCID for archive bucket encryption.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n11" value="" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="870.00" y="370.00" width="820.00" height="205.00" as="geometry" /></mxCell><mxCell id="n12" value="var.policy_compartment_ocid&lt;br&gt;Compartment OCID where the IAM policy is created. Defaults to tenancy_ocid.&lt;br&gt;Default expression: null" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n11"><mxGeometry x="20.00" y="15.00" width="780.00" height="175.00" as="geometry" /></mxCell><mxCell id="n13" value="These inputs identify separately managed resources or override a default selection. The overview and module call-site decide their use.&lt;br&gt;Null/empty defaults do not prove that an external resource exists. Input names and defaults are source contracts, not discovered cloud inventory.&lt;br&gt;Collection inputs can contain further resource references; consult their source schemas and the overview prerequisites. No ownership adoption is implied." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="625.00" width="2540.00" height="130.00" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
