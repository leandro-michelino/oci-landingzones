none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n6" connectable="0"><mxGeometry x="60.95" y="9.52" width="9.52" height="59.05" as="geometry" /></mxCell><mxCell id="n16" value="" style="vsdxID=131;fillColor=#2d5967;gradientColor=none;shape=stencil(lZLbDoMgEES/htcN7uLt2bb/YSJWUisG7e3vKyGmUqOlb7PsGTKQYVQMTdlLhnwYjb7Ih6rGhtGBIaqukUaNk2J0ZFTU2siz0beucnNfWtKqq77bG57Ox60D+Ws5nRzYqm4TjPgOOi9nOM2BJ+E4chAYGiQ4sQf6f5ARCPITpyDyncQJiNgz5BEkO5nXhgwo2+bXiRAB438MP54QYJjEpzW1altXuuX+u2XTkWsoHd8=);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n6" connectable="0"><mxGeometry x="59.05" y="3.81" width="15.24" height="70.48" as="geometry" /></mxCell><mxCell id="n17" value="" style="vsdxID=132;fillColor=#FFFFFF;gradientColor=none;shape=stencil(lZLdDoIwDIWfprfLWAXCNeJ7kDDc4tzIwL+3d7Mxgkacd6ft13PRU8B6VO0gQfBx8u4gL7qbFOAWhNBWSa+noAAbwLp3Xu69O9mO6qGNZFRHd44OV9rDkmVV3BL8Rh3+qHYEG21nMF+AGV9BP31X8XxpvRGs/A4XYZqnez+HSXCBrEq+x1/H+wEH8cqo18ZQxPP5e6ahRf+AzR0=);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n6" connectable="0"><mxGeometry x="22.86" y="5.71" width="30.48" height="68.57" as="geometry" /></mxCell><mxCell id="n18" value="" style="vsdxID=133;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n6" connectable="0"><mxGeometry x="19.05" y="3.81" width="36.19" height="74.29" as="geometry" /></mxCell><mxCell id="n19" value="Optional internal-only Cloud Run adapter / explicit image&lt;br&gt;Dedicated SA / Vertex AI IAM role / explicit run.invoker identities&lt;br&gt;Direct VPC ALL_TRAFFIC egress / deletion protection" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;verticalLabelPosition=top;verticalAlign=bottom;spacingTop=0;spacingBottom=2;" vertex="1" parent="n5"><mxGeometry x="660.00" y="240.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n20" value="" style="shape=mxgraph.gcp2.cloud_run;fillColor=#4285F4;strokeColor=none;" vertex="1" parent="n19" connectable="0"><mxGeometry x="0.00" y="0.00" width="80.00" height="80.00" as="geometry" /></mxCell><mxCell id="n22" value="Existing OCI inference adapter / HTTPS URL&lt;br&gt;Handles caller validation + OCI request signing&lt;br&gt;Not created; raw OCI inference endpoint is not a generic HTTP adapter&lt;br&gt;No API Gateway token broker or shared credential injection" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="650.00" width="1200.00" height="170.00" as="geometry" /></mxCell><mxCell id="n24" value="Existing Vertex AI model/API + separately prepared service APIs&lt;br&gt;Adapter image must implement Google ADC inference calls&lt;br&gt;No custom model, dedicated endpoint, image build or token broker&lt;br&gt;Private VPC and optional NAT do not prove API reachability" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n5"><mxGeometry x="100.00" y="650.00" width="1200.00" height="170.00" as="geometry" /></mxCell><mxCell id="n26" value="No public allUsers or allAuthenticatedUsers invoker. OCI adapters enforce caller authentication; operator attestations are not runtime proof. No inference or token exchange tested." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="100.00" y="1010.00" width="1200.00" height="80.00" as="geometry" /></mxCell><mxCell id="n27" value="DEFAULT RESULT: No cloud resources; cost and creation/workload flags false. Local metadata guards remain. Separate roots and credentials for each cloud.&lt;br&gt;Native detail pages enumerate every root/module/companion declaration, including private networking, flow logs, IAM and service-specific dependencies.&lt;br&gt;Existing projects/APIs, scoped credentials, region eligibility, quota, supported images/versions, address plans, routes and DNS are explicit prerequisites.&lt;br&gt;Only local schema/mocked configuration and diagram checks were run. No provisioning, billing acceptance, connectivity, replication, failover or workload execution was performed." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1360.00" width="2940.00" height="160.00" as="geometry" /></mxCell><mxCell id="n28" value="Source and rendered-diagram review: 2026-10-28. Historical Terraform/provider validation metadata is unchanged.&lt;br&gt;No provisioning, image build/pull, invocation, event delivery, application traffic or cloud test was run." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1570.00" width="2940.00" height="60.00" as="geometry" /></mxCell><mxCell id="n21" value="External secure adapter URL handoff / private route + Google caller token required" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n23" value="Configured /oci/inference HTTP backend when deployment enabled" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n25" value="Application implementation + API/DNS/egress prerequisites" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n24"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="Contracts resources"><mxGraphModel dx="2580" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="630" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Contracts resources | gcp-oci-ai-gateway" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2540.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" va