geometry" /></mxCell><mxCell id="n39" value="" style="vsdxID=106;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n31" connectable="0"><mxGeometry x="2.38" y="0.00" width="44.05" height="44.05" as="geometry" /></mxCell><mxCell id="n40" value="All buckets: NoPublicAccess / Standard / versioned / events enabled; optional existing KMS key.&lt;br&gt;Index/schema descriptors reference existing search infrastructure; they do not create a search cluster or a separate managed index resource." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="40.00" y="325.00" width="490.00" height="175.00" as="geometry" /></mxCell><mxCell id="n41" value="DEFAULT RESULT: No cloud resources. All creation flags false; policy statements and explicit KB/prefix lists empty.&lt;br&gt;The source-prefix binding is added only when both bucket creation and data-source creation are enabled; supplied existing prefixes can be appended.&lt;br&gt;The declared ingestion job can initiate one ingestion when explicitly enabled; creation does not prove completion, indexing quality or retrieval.&lt;br&gt;No FaaS processor, chat client, private endpoint, VCN, model hosting or application authentication layer is created. No ingestion or agent request was executed." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n42" value="Source review: 2026-10-28. No cloud provisioning, provider revalidation, compliance certification, packet test or recovery drill.&lt;br&gt;Placement values are source defaults or marked operator inputs. Arrows are configuration relationships / stated route intent, not verified runtime behavior." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1320.00" width="2460.00" height="65.00" as="geometry" /></mxCell><mxCell id="n15" value="Namespace / bucket / prefix binding" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n16" value="knowledge_base_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n18" value="data_source_id" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n20" value="knowledge_base_ids" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;endArrow=none;exitX=0.