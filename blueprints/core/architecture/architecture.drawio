8OGkvBfZQ9AA==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n88" connectable="0"><mxGeometry x="33.52" y="29.33" width="6.29" height="4.19" as="geometry"/></mxCell><mxCell id="n111" value="" style="vsdxID=153;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n88" connectable="0"><mxGeometry x="29.33" y="13.62" width="3.14" height="7.33" as="geometry"/></mxCell><mxCell id="n112" value="" style="vsdxID=154;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n88" connectable="0"><mxGeometry x="20.95" y="1.05" width="19.90" height="30.38" as="geometry"/></mxCell><mxCell id="n113" value="Enablement and customer inputs required.&lt;br&gt;Security Zones depend on Cloud Guard and a recipe." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n67"><mxGeometry x="20.00" y="180.00" width="480.00" height="45.00" as="geometry"/></mxCell><mxCell id="n114" value="network / default child compartment&lt;br&gt;No VCN, DRG or subnet created by this foundation." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n28"><mxGeometry x="30.00" y="455.00" width="1100.00" height="90.00" as="geometry"/></mxCell><mxCell id="n115" value="workloads / default child compartment&lt;br&gt;No workload instances, databases or application ingress." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n28"><mxGeometry x="1190.00" y="455.00" width="1100.00" height="90.00" as="geometry"/></mxCell><mxCell id="n116" value="CORE DEFAULTS: Compartments, tags, log groups, default IAM groups, dynamic groups and policies are enabled.&lt;br&gt;Cloud Guard, Vault, Security Zones, VSS, Events, Monitoring and Budgets are opt-in. Default parent = tenancy; review IAM/global scope before apply.&lt;br&gt;The log groups do not imply Audit-event ingestion or VCN flow-log collection." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1190.00" width="2360.00" height="130.00" as="geometry"/></mxCell><mxCell id="n117" value="Arrows describe dependencies / configuration, not application traffic or a validated security outcome.&lt;br&gt;Source review: 2026-10-28. No cloud resources created, no new provider validation, compliance audit or enforcement test.&lt;br&gt;Deployment regions, parent compartment, org and environment are operator inputs. Historical validation dates are unchanged." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1355.00" width="2360.00" height="80.00" as="geometry"/></mxCell><mxCell id="n25" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
