<mxfile host="ocidraw" type="device"><diagram id="oci" name="Oracle Cloud VMware Solution | Optional dense/vSAN SDDC on prepared private networking"><mxGraphModel dx="2480" dy="1640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2520" pageHeight="1680" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="Oracle Cloud VMware Solution | Optional dense/vSAN SDDC on prepared private networking" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="10.00" width="2460.00" height="45.00" as="geometry" /></mxCell><mxCell id="n2" value="INDUSTRY / OCVS / Source configuration / VMware components use named boxes; no substitute service icons" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="65.00" width="2460.00" height="30.00" as="geometry" /></mxCell><mxCell id="n3" value="Plain lines: resource-ID bindings. Dashed: external private access or migration prerequisites. No line proves working traffic." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="108.00" width="2460.00" height="30.00" as="geometry" /></mxCell><mxCell id="n4" value="Existing corporate VMware environment / EXTERNAL" style="whiteSpace=wrap;html=1;rounded=1;arcSize=3;align=center;verticalAlign=top;fillColor=#F5F4F2;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="240.00" width="320.00" height="350.00" as="geometry" /></mxCell><mxCell id="n5" value="Source vCenter / ESXi / guest VMs&lt;br&gt;Remote HCX appliances if needed&lt;br&gt;Migration tools, licensing and runbooks&lt;br&gt;Not created or configured by this blueprint" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n4"><mxGeometry x="20.00" y="100.00" width="280.00" height="180.00" as="geometry" /></mxCell><mxCell id="n6" value="Existing private transport + DNS&lt;br&gt;FastConnect / VPN / edge gateways&lt;br&gt;Routes, peering and private name resolution&lt;br&gt;EXTERNAL / not created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="740.00" width="320.00" height="180.00" as="geometry" /></mxCell><mxCell id="n8" value="OCI / selected region and explicit workload compartment / single AD" style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#F5F4F2;rounded=1;arcSize=2;absoluteArcSize=0;strokeColor=#9E9892;fontColor=#312D2A;fontSize=12;fontStyle=1;spacingLeft=6;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="400.00" y="160.00" width="2060.00" height="900.00" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Existing prepared OCVS VCN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#312D2A&quot;&gt;CIDR TBC / not created&lt;/font&gt;" style="whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;spacingTop=2;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n8"><mxGeometry x="35.00" y="80.00" width="1990.00" height="720.00" as="geometry" /></mxCell><mxCell id="n10" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;dashed=1;dashPattern=1 1;strokeColor=#bb511c;strokeWidth=3;fontColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n9"><mxGeometry x="1950.57" y="-15.00" width="31.43" height="30.00" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;Existing ESXi provisioning subnets / per cluster&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#312D2A&quot;&gt;CIDR TBC / public IPs prohibited&lt;/font&gt;" style="whiteSpace=wrap;html=1;strokeWidth=1;dashed=1;align=left;verticalAlign=top;fillColor=none;fontColor=#AE562C;strokeColor=#AE562C;fontSize=12;spacingLeft=5;container=1;collapsible=0;recursiveResize=0;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="40.00" y="100.00" width="650.00" height="175.00" as="geometry" /></mxCell><mxCell id="n12" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;fontColor=#312D2A;strokeColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n11"><mxGeometry x="618.00" y="-12.00" width="24.00" height="24.00" as="geometry" /></mxCell><mxCell id="n13" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;dashed=1;dashPattern=1 1;strokeColor=#bb511c;strokeWidth=3;fontColor=#AE562C;fontFamily=Helvetica;fontSize=12;fillColor=#FCFBFA;" vertex="1" parent="n11"><mxGeometry x="597.71" y="-12.00" width="18.29" height="24.00" as="geometry" /></mxCell><mxCell id="n14" value="MANAGEMENT + each WORKLOAD use dedicated subnet IDs&lt;br&gt;Read-only metadata checks when opted in&lt;br&gt;No subnet, NSG, route table or gateway creation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n11"><mxGeometry x="20.00" y="95.00" width="610.00" height="60.00" as="geometry" /></mxCell><mxCell id="n15" value="Optional OCVS SDDC / enable_sddc=false&lt;br&gt;One MANAGEMENT + explicit WORKLOAD clusters / 3-64 hosts each&lt;br&gt;Dense/vSAN only / explicit AD, shape, VMware bundle and commitment&lt;br&gt;Service-managed ESXi + vCenter + NSX control plane; no guest VMs" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="800.00" y="100.00" width="1110.00" height="175.00" as="geometry" /></mxCell><mxCell id="n16" value="vCenter" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n15"><mxGeometry x="35.00" y="45.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n17" value="" style="shape=mxgraph.vvd.vcenter_server;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="n16" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n18" value="NSX" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n15"><mxGeometry x="1035.00" y="45.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n19" value="" style="shape=mxgraph.vvd.nsx_manager;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="n18" connectable="0"><mxGeometry x="0.00" y="0.00" width="40.00" height="40.00" as="geometry" /></mxCell><mxCell id="n21" value="Existing VLAN identifier bindings / eight baseline roles per cluster&lt;br&gt;vSphere / vMotion / vSAN / NSX host VTEP / NSX Edge VTEP&lt;br&gt;NSX Edge uplink 1 / uplink 2 / Provisioning-Net&lt;br&gt;All clusters use distinct VLAN IDs; same VCN + compartment; compatible AD&lt;br&gt;Selected optional HCX / Replication-Net IDs extend this map" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="40.00" y="355.00" width="1200.00" height="165.00" as="geometry" /></mxCell><mxCell id="n23" value="Optional existing HCX VLAN&lt;br&gt;MANAGEMENT only / enable_hcx=true&lt;br&gt;Remote HCX / licensing / vSphere NAT routing&lt;br&gt;EXTERNAL prerequisites; no pairing executed" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="1390.00" y="355.00" width="520.00" height="165.00" as="geometry" /></mxCell><mxCell id="n25" value="Optional existing Replication-Net VLAN&lt;br&gt;Passed when supplied; required for applicable bundles, including VMware 7.x&lt;br&gt;No replication job, channel, schedule or tested DR is created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="40.00" y="570.00" width="1200.00" height="95.00" as="geometry" /></mxCell><mxCell id="n27" value="Optional existing per-cluster VCF BYOL IDs&lt;br&gt;Global default / per-WORKLOAD override&lt;br&gt;No license purchase or allocation created" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n9"><mxGeometry x="1390.00" y="570.00" width="520.00" height="95.00" as="geometry" /></mxCell><mxCell id="n30" value="Metadata lookups check only VCN/compartment, private provisioning subnet, distinct VLAN IDs and AD compatibility.&lt;br&gt;No complete security/routing/MTU/DNS audit, host capacity, licensing eligibility, migration, management login or application traffic is verified." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n8"><mxGeometry x="40.00" y="820.00" width="1980.00" height="60.00" as="geometry" /></mxCell><mxCell id="n31" value="DEFAULT RESULT: No OCI resources or lookups. Only the local terraform_data guard exists; enable_sddc=false, inspect_existing_network=false and costs_approved=false.&lt;br&gt;Creation requires explicit reviewed costs, network IDs, supported dense shape/bundle/commitment, AD and RSA public SSH key. Read-only inspection can be enabled separately.&lt;br&gt;One cloud resource declaration provisions the SDDC and its initial service-managed clusters/components; it does not duplicate ESXi hosts as individual Terraform resources.&lt;br&gt;No network or external-site resources are created. Optional workload CIDR is an initial NSX input, not guest provisioning. Password outputs are absent; protect deployment state and saved plans." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1150.00" width="2460.00" height="135.00" as="geometry" /></mxCell><mxCell id="n32" value="Local validation: 2026-10-28 / Terraform validate + 19 mocked plans / oracle/oci 9.11.0. No cloud provisioning, VMware login, migration, packet-flow or live cleanup test.&lt;br&gt;Existing CIDRs and regional shape/version/commitment eligibility are operator prerequisites; no live environment or commercial acceptance is implied." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1330.00" width="2460.00" height="60.00" as="geometry" /></mxCell><mxCell id="n33" value="PROPOSED GENERIC WORKLOAD / All three tiers on OCVS guest VMs / no industry dependency / NOT deployed or tested" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=19;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.00" y="1450.00" width="2460.00" height="40.00" as="geometry" /></mxCell><mxCell id="n34" value="Client / browser&lt;br&gt;Existing private entry / HTTPS 443" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1525.00" width="515.00" height="115.00" as="geometry" /></mxCell><mxCell id="n35" value="NGINX web VM&lt;br&gt;Linux / TLS termination + proxy" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="635.00" y="1525.00" width="515.00" height="115.00" as="geometry" /></mxCell><mxCell id="n36" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n35"><mxGeometry x="14.00" y="41.50" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n37" value="" style="shape=mxgraph.vvd.virtual_machine;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="n36" connectable="0"><mxGeometry x="0.00" y="0.00" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n38" value="Spring Boot API VM&lt;br&gt;Linux / identity and secrets required" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1250.00" y="1525.00" width="515.00" height="115.00" as="geometry" /></mxCell><mxCell id="n39" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;recursiveResize=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;labelPosition=center;whiteSpace=nowrap;fontSize=10;fontColor=#312D2A;spacingTop=-2;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n38"><mxGeometry x="14.00" y="41.50" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n40" value="" style="shape=mxgraph.vvd.virtual_machine;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1.5;" vertex="1" parent="n39" connectable="0"><mxGeometry x="0.00" y="0.00" width="32.00" height="32.00" as="geometry" /></mxCell><mxCell id="n41" value="PostgreSQL VM&lt;br&gt;TLS / backup + WAL archive / restore test" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;dashed=1;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="1865.00" y="1525.00" width="515.00" height="115.00" as="geometry" /></mxCell><mxCell id="n42" value="" style="html=1;fillColor=none;strokeColor=none;container=1;collapsible=0;r