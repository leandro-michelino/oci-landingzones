2" connectable="0"><mxGeometry x="9.43" y="17.81" width="3.14" height="1.05" as="geometry" /></mxCell><mxCell id="n143" value="" style="vsdxID=151;fillColor=#2d5967;gradientColor=none;shape=stencil(nZBLCoAwDERPk31tjuDnHoLVBmsrtf5ub0sQRdzobiZ5ycAA5pOuRwVSTMG7Xq3UBA1YgJRktfIUogIsAfPWedV5N9uG/VgnMqnBLenDxneZEOlGip09u4pRQ/aG/gTPhFf0Gf8J/otGcdXRkjHc5n3/rC+OuHosDw==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n122" connectable="0"><mxGeometry x="5.24" y="17.81" width="3.14" height="1.05" as="geometry" /></mxCell><mxCell id="n144" value="" style="vsdxID=152;fillColor=#2d5967;gradientColor=none;shape=stencil(pZLbDoIwDIafZrdNt7IJ14jvQcKQRWRkgIe3l7kYwQSReNd239/D8jNKuypvNRPY9c6e9NUUfcVoz4QwTaWd6ceIUcYoLa3TR2eHpgh5m3vSR2d78R1uQYdeIfAesh1Bwp+VQ4Br00xgLoGrmSCRoKJlASUQ8ZlAEeAmAUdcxpUALv7BV9aJI4jlloNf43/8UImA83O/bL+p8wo8Bm9HlKaug6Gm758OGkvBfZQ9AA==);strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n122" connectable="0"><mxGeometry x="33.52" y="29.33" width="6.29" height="4.19" as="geometry" /></mxCell><mxCell id="n145" value="" style="vsdxID=153;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n122" connectable="0"><mxGeometry x="29.33" y="13.62" width="3.14" height="7.33" as="geometry" /></mxCell><mxCell id="n146" value="" style="vsdxID=154;fillColor=#2d5967;gradientColor=none;shape=stencil();strokeColor=none;spacingTop=-3;spacingBottom=-3;spacingLeft=-3;spacingRight=-3;points=[];labelBackgroundColor=none;rounded=0;html=1;whiteSpace=wrap;" vertex="1" parent="n122" connectable="0"><mxGeometry x="20.95" y="1.05" width="19.90" height="30.38" as="geometry" /></mxCell><mxCell id="n147" value="Enablement and customer inputs required.&lt;br&gt;Security Zones depend on Cloud Guard and a recipe." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n101"><mxGeometry x="20.00" y="180.00" width="480.00" height="45.00" as="geometry" /></mxCell><mxCell id="n148" value="network / default child compartment&lt;br&gt;No VCN, DRG or subnet created by this foundation." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n28"><mxGeometry x="30.00" y="455.00" width="1100.00" height="90.00" as="geometry" /></mxCell><mxCell id="n149" value="workloads / default child compartment&lt;br&gt;No workload instances, databases or application ingress." style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FCFBFA;strokeColor=#759C6C;fontColor=#161513;fontSize=11;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="n28"><mxGeometry x="1190.00" y="455.00" width="1100.00" height="90.00" as="geometry" /></mxCell><mxCell id="n150" value="CIS LEVEL1: Uses pinned Core with cis_level=level1 and a compliance tag.&lt;br&gt;Audit retention, Cloud Guard and Events are enabled; Vault, Security Zones, VSS and Monitoring are disabled. Budget creation needs amount/map inputs.&lt;br&gt;Level 1 and Level 2 wrappers currently have the same service-enable defaults; the label alone is not CIS certification or full control coverage." style="whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FCFBFA;strokeColor=#9E9892;fontColor=#312D2A;fontSize=10;spacing=6;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1190.00" width="2360.00" height="130.00" as="geometry" /></mxCell><mxCell id="n151" value="Arrows describe dependencies / configuration, not application traffic or a validated security outcome.&lt;br&gt;Source review: 2026-10-28. No cloud resources created, no new provider validation, compliance audit or enforcement test.&lt;br&gt;Deployment regions, parent compartment, org and environment are operator inputs. Historical validation dates are unchanged." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;" vertex="1" parent="1"><mxGeometry x="20.00" y="1355.00" width="2360.00" height="80.00" as="geometry" /></mxCell><mxCell id="n25" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n92" value="" style="html=1;endArrow=open;endFill=0;startFill=0;rounded=0;endSize=6;startSize=6;strokeColor=#312D2A;fontSize=10;fontColor=#312D2A;labelBackgroundColor=#FFFFFF;fontFamily=Oracle Sans,Arial,Helvetica,sans-serif;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n58" target="n62"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="resource-detail-0" name="OCI resources"><mxGraphModel dx="2580" dy="1690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2620" pageHeight="1730" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="OCI resources | level1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=25;fontColor=#312D2A;fontFamily=Oracle Sans,Arial,Helvetica,sans-se